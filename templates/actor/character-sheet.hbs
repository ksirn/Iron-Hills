<form class="iron-hills-sheet ih-char-sheet">

  {{!-- ШАПКА --}}
  <div class="ih-cs-header">
    <div class="ih-cs-portrait-wrap">
      <img class="ih-cs-portrait" src="{{actor.img}}" alt="{{actor.name}}">
      <div class="ih-cs-effects">
        {{#if system.conditions.bleeding}}<span class="ih-cs-fx is-bleeding" title="Кровотечение: {{system.conditions.bleeding}}"><i class="fas fa-droplet"></i></span>{{/if}}
        {{#if system.conditions.poison}}<span class="ih-cs-fx is-poison" title="Яд: {{system.conditions.poison}}"><i class="fas fa-skull"></i></span>{{/if}}
        {{#if system.conditions.burning}}<span class="ih-cs-fx is-burning" title="Горение: {{system.conditions.burning}}"><i class="fas fa-fire"></i></span>{{/if}}
        {{#if system.conditions.shock}}<span class="ih-cs-fx is-shock" title="Шок: {{system.conditions.shock}}"><i class="fas fa-bolt"></i></span>{{/if}}
        {{#if system.conditions.stunned}}<span class="ih-cs-fx is-stunned" title="Оглушение: {{system.conditions.stunned}}"><i class="fas fa-dizzy"></i></span>{{/if}}
      </div>
    </div>

    <div class="ih-cs-identity">
      <input class="ih-cs-name" type="text" name="name" value="{{actor.name}}">
      <div class="ih-cs-meta-row">
        <div class="ih-cs-meta-field">
          <label>Раса</label>
          <select name="system.info.race">
            <option value="human"     {{#if (eq system.info.race 'human')}}selected{{/if}}>Человек</option>
            <option value="dwarf"     {{#if (eq system.info.race 'dwarf')}}selected{{/if}}>Гном</option>
            <option value="halfling"  {{#if (eq system.info.race 'halfling')}}selected{{/if}}>Полурослик</option>
            <option value="goblin"    {{#if (eq system.info.race 'goblin')}}selected{{/if}}>Гоблин</option>
            <option value="stoneling" {{#if (eq system.info.race 'stoneling')}}selected{{/if}}>Каменник</option>
            <option value="other"     {{#if (eq system.info.race 'other')}}selected{{/if}}>Иное</option>
          </select>
        </div>
        <div class="ih-cs-meta-field narrow">
          <label>Возраст</label>
          <input type="number" name="system.info.age" value="{{system.info.age}}">
        </div>
        <div class="ih-cs-meta-field">
          <label>Фракция</label>
          <input type="text" name="system.info.faction" value="{{system.info.faction}}" placeholder="—">
        </div>
        <div class="ih-cs-meta-field">
          <label>Роль/Класс</label>
          <input type="text" name="system.info.role" value="{{system.info.role}}" placeholder="—">
        </div>
      </div>
    </div>

    <div class="ih-cs-coins-block">
      <div class="ih-cs-coins-title">Монеты</div>
      <div class="ih-cs-coin-row"><span class="ih-cs-coin-label is-copper">Медь</span><input type="number" name="system.currency.copper" value="{{system.currency.copper}}" min="0" class="ih-cs-coin-input"></div>
      <div class="ih-cs-coin-row"><span class="ih-cs-coin-label is-silver">Серебро</span><input type="number" name="system.currency.silver" value="{{system.currency.silver}}" min="0" class="ih-cs-coin-input"></div>
      <div class="ih-cs-coin-row"><span class="ih-cs-coin-label is-gold">Золото</span><input type="number" name="system.currency.gold" value="{{system.currency.gold}}" min="0" class="ih-cs-coin-input"></div>
    </div>
  </div>

  {{!-- ТЕЛО --}}
  <div class="ih-cs-body">

    {{!-- ЛЕВАЯ: тело + ресурсы + душа --}}
    <div class="ih-cs-left">

      <div class="ih-cs-section">
        <div class="ih-cs-section-title">
          <span>Тело</span>
          {{#if medicalTriage.visible}}
          <span class="ih-cs-section-meta ih-cs-triage-meta {{medicalTriage.severityClass}}">{{medicalTriage.bodyStatusLabel}}</span>
          {{/if}}
        </div>
        <div class="ih-cs-body-layout">

          {{!-- Силуэт человечка --}}
          <div class="ih-cs-figure">
            {{#each zones}}{{#if (eq key "head")}}
            <div class="ih-cs-fig-part ih-cs-fig-head {{cssClass}}" title="{{tooltip}}">
              <div class="ih-cs-fig-fill" data-ih-style-height-pct="{{pct}}"></div>
              <span class="ih-cs-fig-label">Г</span>
              {{#if trauma.majorBleeding}}<span class="ih-fig-dot dot-major"></span>{{/if}}
              {{#if trauma.minorBleeding}}<span class="ih-fig-dot dot-minor"></span>{{/if}}
              {{#if trauma.destroyed}}<span class="ih-fig-dot dot-destroyed"></span>{{/if}}
            </div>
            {{/if}}{{/each}}
            <div class="ih-cs-fig-row">
              {{#each zones}}{{#if (eq key "leftArm")}}
              <div class="ih-cs-fig-part ih-cs-fig-arm {{cssClass}}" title="{{tooltip}}">
                <div class="ih-cs-fig-fill" data-ih-style-height-pct="{{pct}}"></div>
                <span class="ih-cs-fig-label">Л</span>
                {{#if trauma.fracture}}<span class="ih-fig-dot dot-fracture"></span>{{/if}}
                {{#if trauma.splinted}}<span class="ih-fig-dot dot-splinted"></span>{{/if}}
                {{#if trauma.majorBleeding}}<span class="ih-fig-dot dot-major"></span>{{/if}}
                {{#if trauma.destroyed}}<span class="ih-fig-dot dot-destroyed"></span>{{/if}}
              </div>
              {{/if}}{{/each}}
              {{#each zones}}{{#if (eq key "torso")}}
              <div class="ih-cs-fig-part ih-cs-fig-torso {{cssClass}}" title="{{tooltip}}">
                <div class="ih-cs-fig-fill" data-ih-style-height-pct="{{pct}}"></div>
                <span class="ih-cs-fig-label">Т</span>
                {{#if trauma.majorBleeding}}<span class="ih-fig-dot dot-major"></span>{{/if}}
                {{#if trauma.minorBleeding}}<span class="ih-fig-dot dot-minor"></span>{{/if}}
                {{#if trauma.destroyed}}<span class="ih-fig-dot dot-destroyed"></span>{{/if}}
              </div>
              {{/if}}{{/each}}
              {{#each zones}}{{#if (eq key "rightArm")}}
              <div class="ih-cs-fig-part ih-cs-fig-arm {{cssClass}}" title="{{tooltip}}">
                <div class="ih-cs-fig-fill" data-ih-style-height-pct="{{pct}}"></div>
                <span class="ih-cs-fig-label">П</span>
                {{#if trauma.fracture}}<span class="ih-fig-dot dot-fracture"></span>{{/if}}
                {{#if trauma.splinted}}<span class="ih-fig-dot dot-splinted"></span>{{/if}}
                {{#if trauma.majorBleeding}}<span class="ih-fig-dot dot-major"></span>{{/if}}
                {{#if trauma.destroyed}}<span class="ih-fig-dot dot-destroyed"></span>{{/if}}
              </div>
              {{/if}}{{/each}}
            </div>
            {{#each zones}}{{#if (eq key "abdomen")}}
            <div class="ih-cs-fig-part ih-cs-fig-abdomen {{cssClass}}" title="{{tooltip}}">
              <div class="ih-cs-fig-fill" data-ih-style-height-pct="{{pct}}"></div>
              <span class="ih-cs-fig-label">Ж</span>
              {{#if trauma.majorBleeding}}<span class="ih-fig-dot dot-major"></span>{{/if}}
              {{#if trauma.destroyed}}<span class="ih-fig-dot dot-destroyed"></span>{{/if}}
            </div>
            {{/if}}{{/each}}
            <div class="ih-cs-fig-row">
              {{#each zones}}{{#if (eq key "leftLeg")}}
              <div class="ih-cs-fig-part ih-cs-fig-leg {{cssClass}}" title="{{tooltip}}">
                <div class="ih-cs-fig-fill" data-ih-style-height-pct="{{pct}}"></div>
                <span class="ih-cs-fig-label">Л</span>
                {{#if trauma.fracture}}<span class="ih-fig-dot dot-fracture"></span>{{/if}}
                {{#if trauma.splinted}}<span class="ih-fig-dot dot-splinted"></span>{{/if}}
                {{#if trauma.destroyed}}<span class="ih-fig-dot dot-destroyed"></span>{{/if}}
              </div>
              {{/if}}{{/each}}
              <div class="ih-cs-fig-gap"></div>
              {{#each zones}}{{#if (eq key "rightLeg")}}
              <div class="ih-cs-fig-part ih-cs-fig-leg {{cssClass}}" title="{{tooltip}}">
                <div class="ih-cs-fig-fill" data-ih-style-height-pct="{{pct}}"></div>
                <span class="ih-cs-fig-label">П</span>
                {{#if trauma.fracture}}<span class="ih-fig-dot dot-fracture"></span>{{/if}}
                {{#if trauma.splinted}}<span class="ih-fig-dot dot-splinted"></span>{{/if}}
                {{#if trauma.destroyed}}<span class="ih-fig-dot dot-destroyed"></span>{{/if}}
              </div>
              {{/if}}{{/each}}
            </div>
          </div>{{!-- .ih-cs-figure --}}

          {{!-- HP поля рядом с силуэтом --}}
          <div class="ih-cs-hp-list">
            {{#each zones}}
            <div class="ih-cs-hp-row {{cssClass}}" title="{{tooltip}}">
              <span class="ih-cs-hp-label">{{label}}</span>
              <input type="number" name="system.resources.hp.{{key}}.value"
                     value="{{value}}" class="ih-cs-hp-input">
              <span class="ih-cs-hp-max">/{{max}}</span>
              <div class="ih-cs-hp-bar-track">
                <div class="ih-cs-hp-bar-fill" data-ih-style-width-pct="{{pct}}"></div>
              </div>
              <div class="ih-cs-zone-dots">
                {{#if trauma.majorBleeding}}<span class="ih-fig-dot dot-major" title="{{trauma.majorBleedingTitle}}"></span>{{/if}}
                {{#if trauma.minorBleeding}}<span class="ih-fig-dot dot-minor" title="Кровь {{trauma.minorBleeding}}"></span>{{/if}}
                {{#if trauma.fracture}}<span class="ih-fig-dot dot-fracture" title="Перелом"></span>{{/if}}
                {{#if trauma.splinted}}<span class="ih-fig-dot dot-splinted" title="Шина"></span>{{/if}}
                {{#if trauma.tourniquet}}<span class="ih-fig-dot dot-tourniquet" title="Жгут"></span>{{/if}}
                {{#if trauma.destroyed}}<span class="ih-fig-dot dot-destroyed" title="Уничтожено"></span>{{/if}}
              </div>
            </div>
            {{/each}}
          </div>

        </div>
        {{#if medicalTriage.visible}}
        <div class="ih-cs-triage {{medicalTriage.severityClass}}">
          <div class="ih-cs-triage-head">
            <span class="ih-cs-triage-icon">{{medicalTriage.icon}}</span>
            <div class="ih-cs-triage-titlebox">
              <div class="ih-cs-triage-title">{{medicalTriage.title}}</div>
              <div class="ih-cs-triage-note">{{medicalTriage.actionHint}}</div>
            </div>
            <span class="ih-cs-triage-action">{{medicalTriage.primaryAction}}</span>
          </div>
          <div class="ih-cs-triage-chips">
            {{#each medicalTriage.statChips}}
            <span class="ih-med-chip {{cssClass}}"><b>{{label}}</b>{{value}}</span>
            {{/each}}
          </div>
          {{#if medicalTriage.hasRecommendedParts}}
          <div class="ih-cs-triage-parts">
            {{#each medicalTriage.recommendedPreview}}
            <div class="ih-cs-triage-part {{cssClass}}">
              <span class="ih-cs-triage-part-name">{{label}}</span>
              <span class="ih-cs-triage-part-hp">{{hpLabel}}</span>
              <span class="ih-cs-triage-part-action">{{recommendedAction}}</span>
            </div>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/if}}
      </div>

      <div class="ih-cs-section">
        <div class="ih-cs-section-title">Ресурсы</div>
        <div class="ih-cs-resources">
          <div class="ih-cs-res-row">
            <span class="ih-cs-res-icon energy">⚡</span>
            <span class="ih-cs-res-name">Энергия</span>
            <div class="ih-cs-res-vals">
              <input type="number" name="system.resources.energy.value" value="{{system.resources.energy.value}}" class="ih-cs-res-input">
              <span class="ih-cs-res-max">/{{system.resources.energy.max}}</span>
            </div>
            <div class="ih-cs-res-track"><div class="ih-cs-res-fill energy" data-ih-style-width-pct="{{overviewSummary.energyPct}}"></div></div>
            {{#if overviewSummary.unconscious}}
            <div class="ih-cs-debuff-tag is-danger">💀 Без сознания</div>
            {{/if}}
          </div>
          <div class="ih-cs-res-row">
            <span class="ih-cs-res-icon mana">✦</span>
            <span class="ih-cs-res-name">Мана</span>
            <div class="ih-cs-res-vals">
              <input type="number" name="system.resources.mana.value" value="{{system.resources.mana.value}}" class="ih-cs-res-input">
              <span class="ih-cs-res-max">/{{system.resources.mana.max}}</span>
            </div>
            <div class="ih-cs-res-track"><div class="ih-cs-res-fill mana" data-ih-style-width-pct="{{overviewSummary.manaPct}}"></div></div>
          </div>
          <div class="ih-cs-res-row">
            <span class="ih-cs-res-icon food">🍖</span>
            <span class="ih-cs-res-name">Сытость</span>
            <div class="ih-cs-res-vals">
              <input type="number" name="system.resources.satiety.value" value="{{system.resources.satiety.value}}" class="ih-cs-res-input">
              <span class="ih-cs-res-max">/{{system.resources.satiety.max}}</span>
            </div>
            <div class="ih-cs-res-track"><div class="ih-cs-res-fill food" data-ih-style-width-pct="{{overviewSummary.satietyPct}}"></div></div>
            {{#if overviewSummary.hungerState}}
            <div class="ih-cs-debuff-tag" data-ih-style-color="{{overviewSummary.hungerState.color}}"
                 title="−{{overviewSummary.hungerState.penalty}} макс. энергии">
              {{overviewSummary.hungerState.icon}} {{overviewSummary.hungerState.label}}
            </div>
            {{/if}}
          </div>
          <div class="ih-cs-res-row">
            <span class="ih-cs-res-icon water">💧</span>
            <span class="ih-cs-res-name">Жажда</span>
            <div class="ih-cs-res-vals">
              <input type="number" name="system.resources.hydration.value" value="{{system.resources.hydration.value}}" class="ih-cs-res-input">
              <span class="ih-cs-res-max">/{{system.resources.hydration.max}}</span>
            </div>
            <div class="ih-cs-res-track"><div class="ih-cs-res-fill water" data-ih-style-width-pct="{{overviewSummary.hydrationPct}}"></div></div>
            {{#if overviewSummary.thirstState}}
            <div class="ih-cs-debuff-tag" data-ih-style-color="{{overviewSummary.thirstState.color}}"
                 title="−{{overviewSummary.thirstState.penalty}} макс. энергии">
              {{overviewSummary.thirstState.icon}} {{overviewSummary.thirstState.label}}
            </div>
            {{/if}}
          </div>
          <div class="ih-cs-res-row">
            <span class="ih-cs-res-icon weight">⚖</span>
            <span class="ih-cs-res-name">Нагрузка</span>
            <span class="ih-cs-res-static">{{overviewSummary.weightValue}}/{{overviewSummary.weightMax}}</span>
            <div class="ih-cs-res-track"><div class="ih-cs-res-fill weight" data-ih-style-width-pct="{{overviewSummary.weightPct}}"></div></div>
          </div>
        </div>
      </div>

      {{#if recoveryPlan.visible}}
      <div class="ih-cs-section">
        <div class="ih-cs-section-title">
          <span>Восстановление</span>
          <span class="ih-cs-section-meta ih-cs-recovery-meta {{recoveryPlan.status.cssClass}}">{{recoveryPlan.status.title}}</span>
        </div>
        <div class="ih-cs-recovery {{recoveryPlan.status.cssClass}}">
          <div class="ih-cs-recovery-head">
            <div class="ih-cs-recovery-status">
              <span class="ih-cs-recovery-status-title">{{recoveryPlan.status.title}}</span>
              <span class="ih-cs-recovery-status-detail">{{recoveryPlan.status.detail}}</span>
            </div>
            <div class="ih-cs-recovery-actions">
              <a class="ih-btn ih-btn-small" data-update-effects title="Применить тик состояний">Тик</a>
              {{#if recoveryPlan.shortRest.canUse}}
              <a class="ih-btn ih-btn-small" data-short-rest title="Короткий отдых">Короткий</a>
              {{else}}
              <a class="ih-btn ih-btn-small is-disabled" title="{{recoveryPlan.shortRest.blockedReason}}">Короткий</a>
              {{/if}}
              {{#if recoveryPlan.fullRest.canUse}}
              <a class="ih-btn ih-btn-small ih-btn-primary" data-full-rest title="Полный отдых">Полный</a>
              {{else}}
              <a class="ih-btn ih-btn-small is-disabled" title="{{recoveryPlan.fullRest.blockedReason}}">Полный</a>
              {{/if}}
            </div>
          </div>

          {{#if recoveryPlan.hasWarnings}}
          <div class="ih-cs-recovery-warnings">
            {{#each recoveryPlan.warningPreview}}
            <span class="ih-rec-chip {{cssClass}}"><b>{{label}}</b>{{value}}</span>
            {{/each}}
          </div>
          {{/if}}

          <div class="ih-cs-recovery-rests">
            <div class="ih-cs-rest-card {{recoveryPlan.shortRest.cssClass}}">
              <div class="ih-cs-rest-title">{{recoveryPlan.shortRest.title}}</div>
              {{#each recoveryPlan.shortRest.rows}}
              <div class="ih-cs-rest-row {{cssClass}}">
                <span>{{label}}</span><b>{{delta}}</b><em>{{value}}</em>
              </div>
              {{/each}}
            </div>
            <div class="ih-cs-rest-card {{recoveryPlan.fullRest.cssClass}}">
              <div class="ih-cs-rest-title">{{recoveryPlan.fullRest.title}}</div>
              {{#if recoveryPlan.fullRest.hasBlockers}}
              <div class="ih-cs-rest-blockers">
                {{#each recoveryPlan.fullRest.blockers}}<span>{{label}}</span>{{/each}}
              </div>
              {{/if}}
              {{#each recoveryPlan.fullRest.rows}}
              <div class="ih-cs-rest-row {{cssClass}}">
                <span>{{label}}</span><b>{{delta}}</b><em>{{value}}</em>
              </div>
              {{/each}}
            </div>
          </div>

          {{#if recoveryPlan.hasActiveConditions}}
          <div class="ih-cs-recovery-effects">
            {{#each recoveryPlan.activeConditionPreview}}
            <span class="ih-rec-effect {{cssClass}}" title="{{label}}: {{valueLabel}}">
              <i class="fas {{icon}}"></i><span>{{label}}</span><b>{{valueLabel}}</b>
            </span>
            {{/each}}
          </div>
          {{/if}}
        </div>
      </div>
      {{/if}}

      {{!-- Болезни --}}
      {{#if diseases.length}}
      <div class="ih-cs-section">
        <div class="ih-cs-section-title">
          Болезни
          {{#if isGM}}<a class="ih-cs-section-action" data-add-disease title="Заразить">+ Добавить</a>{{/if}}
        </div>
        <div class="ih-cs-diseases">
          {{#each diseases}}
          <div class="ih-cs-disease stage-{{currentStage}}">
            <span class="ih-cs-disease-icon">{{icon}}</span>
            <div class="ih-cs-disease-info">
              <span class="ih-cs-disease-name">{{label}}</span>
              <span class="ih-cs-disease-stage">{{stageName}}</span>
              <div class="ih-cs-disease-bar">
                <div class="ih-cs-disease-bar-fill" data-ih-style-width-pct="{{progressPct}}"></div>
              </div>
            </div>
            {{#if ../isGM}}
            <a class="ih-icon-btn" data-cure-disease="{{key}}" title="Вылечить">✕</a>
            {{/if}}
          </div>
          {{/each}}
        </div>
      </div>
      {{else if isGM}}
      <div class="ih-cs-section">
        <div class="ih-cs-section-title">
          Болезни
          <a class="ih-cs-section-action" data-add-disease title="Заразить">+ Добавить</a>
        </div>
        <div class="ih-cs-no-diseases muted-text">Здоров</div>
      </div>
      {{/if}}

      {{!-- Пробудившийся --}}
      <div class="ih-cs-section">
        <div class="ih-cs-section-title">
          Пробудившийся
          {{#if isGM}}
          <a class="ih-cs-section-action" data-toggle-awakened>
            {{#if system.resources.awakened.isAwakened}}⬤ Активен{{else}}◯ Нет{{/if}}
          </a>
          {{/if}}
        </div>
        {{#if system.resources.awakened.isAwakened}}
        <div class="ih-cs-awakened">
          <div class="ih-cs-awakened-badge">⚡ Пробудившийся</div>
          <div class="ih-cs-awakened-fields">
            <label>Игрок (из нашего мира)
              <input type="text" name="system.resources.awakened.playerName"
                     value="{{system.resources.awakened.playerName}}"
                     placeholder="Имя..." {{#unless isGM}}readonly{{/unless}}>
            </label>
            <label>Тип пробуждения
              {{#if isGM}}
              <select name="system.resources.awakened.awakeningType">
                <option value="" {{#unless system.resources.awakened.awakeningType}}selected{{/unless}}>— не задано —</option>
                <option value="mental"    {{#if (eq system.resources.awakened.awakeningType 'mental')}}selected{{/if}}>Ментальный недуг носителя</option>
                <option value="weak-soul" {{#if (eq system.resources.awakened.awakeningType 'weak-soul')}}selected{{/if}}>Слабая душа носителя</option>
                <option value="ritual"    {{#if (eq system.resources.awakened.awakeningType 'ritual')}}selected{{/if}}>Ритуал</option>
                <option value="accident"  {{#if (eq system.resources.awakened.awakeningType 'accident')}}selected{{/if}}>Случайность</option>
                <option value="unknown"   {{#if (eq system.resources.awakened.awakeningType 'unknown')}}selected{{/if}}>Неизвестно</option>
              </select>
              {{else}}
              <span class="muted-text">{{system.resources.awakened.awakeningType}}</span>
              {{/if}}
            </label>
            <label>Дата пробуждения
              <input type="text" name="system.resources.awakened.awakeningDate"
                     value="{{system.resources.awakened.awakeningDate}}"
                     placeholder="День X эпохи Y..." {{#unless isGM}}readonly{{/unless}}>
            </label>
            {{#if system.resources.awakened.notes}}
            <div class="ih-cs-awakened-notes">{{system.resources.awakened.notes}}</div>
            {{/if}}
          </div>
        </div>
        {{else}}
        <div class="ih-cs-awakened-none muted-text">Обычная душа</div>
        {{/if}}
      </div>

      <div class="ih-cs-section">
        <div class="ih-cs-section-title">Резерв души</div>
        <div class="ih-cs-soul-grid">
          {{!-- Энергия резерва --}}
          <div class="ih-cs-soul-item">
            <span class="ih-cs-soul-label energy">⚡ Энергия</span>
            <div class="ih-cs-soul-val">{{system.resources.soul.energyReserve.value}} / {{system.resources.soul.energyReserve.max}}</div>
            {{!-- Прогресс раскачки --}}
            {{#if system.resources.soul.energyReserve.max}}
            <div class="ih-cs-soul-accum" title="Накоплено восстановлений: {{system.resources.soul.energyReserve.trainingAccum}} / {{system.resources.soul.energyReserve.max}}">
              <div class="ih-cs-soul-accum-fill energy" data-ih-style-width-pct="{{soulEnergyTrainPct}}"></div>
            </div>
            <span class="ih-cs-soul-accum-label">{{system.resources.soul.energyReserve.trainingAccum}} / {{system.resources.soul.energyReserve.max}}</span>
            {{/if}}
          </div>
          {{!-- Мана резерва --}}
          <div class="ih-cs-soul-item">
            <span class="ih-cs-soul-label mana">✦ Мана</span>
            <div class="ih-cs-soul-val">{{system.resources.soul.manaReserve.value}} / {{system.resources.soul.manaReserve.max}}</div>
            {{#if system.resources.soul.manaReserve.max}}
            <div class="ih-cs-soul-accum" title="Накоплено восстановлений: {{system.resources.soul.manaReserve.trainingAccum}} / {{system.resources.soul.manaReserve.max}}">
              <div class="ih-cs-soul-accum-fill mana" data-ih-style-width-pct="{{soulManaTrainPct}}"></div>
            </div>
            <span class="ih-cs-soul-accum-label">{{system.resources.soul.manaReserve.trainingAccum}} / {{system.resources.soul.manaReserve.max}}</span>
            {{/if}}
          </div>
          {{#if system.resources.soulReserve.isDead}}
          <div class="ih-cs-soul-warning">☠ Мёртв — день {{system.resources.soulReserve.daysSinceDeath}}</div>
          {{/if}}
        </div>
      </div>

    {{!-- Болезни --}}
    {{#if activeDiseases.length}}
    <div class="ih-cs-section">
      <div class="ih-cs-section-title">Болезни</div>
      <div class="ih-cs-diseases">
        {{#each activeDiseases}}
        <div class="ih-cs-disease">
          <span class="ih-cs-disease-icon">{{icon}}</span>
          <div class="ih-cs-disease-info">
            <span class="ih-cs-disease-name">{{label}}</span>
            <span class="ih-cs-disease-stage">{{stageLabel}} · {{duration}}ч</span>
          </div>
          {{#if ../isGM}}
          <a class="ih-icon-btn" data-cure-disease="{{key}}" title="Вылечить">✕</a>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    </div>

    {{!-- ПРАВАЯ: навыки + инвентарь --}}
    <div class="ih-cs-right">

      <div class="ih-cs-section">
        <div class="ih-cs-section-title">Навыки</div>
        <div class="ih-cs-skills">
          {{#each skillGroups}}
          <div class="ih-cs-skill-group">
            <div class="ih-cs-skill-group-title">{{label}}</div>
            {{#each skills}}
            <div class="ih-cs-skill-row"
                 data-skill-roll="{{key}}" data-label="{{label}}"
                 title="Кликни для броска">
              <span class="ih-cs-skill-name">{{label}}</span>
              <span class="ih-cs-skill-die">d{{dieSize}}</span>
              <div class="ih-cs-skill-exp-track" title="{{exp}} / {{expNext}}">
                <div class="ih-cs-skill-exp-fill" data-ih-style-width-pct="{{expPct}}"></div>
              </div>
              <span class="ih-cs-skill-tier">{{value}}</span>
            </div>
            {{/each}}
          </div>
          {{/each}}
        </div>
      </div>

      {{!-- Репутация --}}
      {{#if (or settlementRelations.length factionRelations.length)}}
      <div class="ih-cs-section">
        <div class="ih-cs-section-title">
          Репутация
          {{#if isGM}}<a class="ih-cs-section-action" data-add-relation>+ Добавить</a>{{/if}}
        </div>
        <div class="ih-cs-relations">
          {{#each factionRelations}}
          <div class="ih-cs-relation" title="{{targetName}}">
            <div class="ih-cs-rel-bar-wrap">
              <span class="ih-cs-rel-name">{{targetName}}</span>
              <div class="ih-cs-rel-bar">
                <div class="ih-cs-rel-fill {{#if (gt score 0)}}positive{{else if (lt score 0)}}negative{{/if}}"
                     data-ih-style-width-pct="{{relPct}}"
                     {{#if (gt score 0)}}data-ih-style-margin-left-pct="50"{{else}}data-ih-style-margin-left-pct="{{relLeft}}"{{/if}}></div>
                <div class="ih-cs-rel-center"></div>
              </div>
              <span class="ih-cs-rel-score {{#if (gt score 0)}}text-good{{else if (lt score 0)}}text-bad{{/if}}">{{score}}</span>
            </div>
            <div class="ih-cs-rel-tier muted-text">{{tier}}</div>
            {{#if ../isGM}}
            <div class="ih-cs-rel-actions">
              <a class="ih-icon-btn" data-rel-change="10"  data-rel-id="{{id}}" title="+10">▲</a>
              <a class="ih-icon-btn" data-rel-change="-10" data-rel-id="{{id}}" title="-10">▼</a>
            </div>
            {{/if}}
          </div>
          {{/each}}
          {{#each settlementRelations}}
          <div class="ih-cs-relation settlement">
            <div class="ih-cs-rel-bar-wrap">
              <span class="ih-cs-rel-name">{{targetName}}</span>
              <div class="ih-cs-rel-bar">
                <div class="ih-cs-rel-fill {{#if (gt score 0)}}positive{{else if (lt score 0)}}negative{{/if}}"
                     data-ih-style-width-pct="{{relPct}}"></div>
                <div class="ih-cs-rel-center"></div>
              </div>
              <span class="ih-cs-rel-score">{{score}}</span>
            </div>
            {{#if ../isGM}}
            <div class="ih-cs-rel-actions">
              <a class="ih-icon-btn" data-rel-change="10"  data-rel-id="{{id}}" title="+10">▲</a>
              <a class="ih-icon-btn" data-rel-change="-10" data-rel-id="{{id}}" title="-10">▼</a>
            </div>
            {{/if}}
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <div class="ih-cs-section">
        <div class="ih-cs-section-title">
          Инвентарь
          <span class="ih-cs-section-meta">{{overviewSummary.weightValue}}/{{overviewSummary.weightMax}} кг</span>
        </div>
        <div class="ih-cs-inventory">
          {{#each groupedItems}}
          {{#if items.length}}
          <div class="ih-cs-inv-group">
            <div class="ih-cs-inv-group-title">{{label}}</div>
            {{#each items}}
            <div class="ih-cs-inv-row ih-cs-inv-row-simple">
              <img class="ih-cs-inv-icon" src="{{img}}" alt="{{name}}">
              <span class="ih-cs-inv-name">{{name}}</span>
              {{#if system.quantity}}<span class="ih-cs-inv-qty">×{{system.quantity}}</span>{{/if}}
              {{#if system.durability}}
              <div class="ih-cs-inv-dur-track" title="Прочность: {{system.durability.value}}/{{system.durability.max}}">
                <div class="ih-cs-inv-dur-fill {{#if (lt system.durability.value 25)}}is-crit{{else if (lt system.durability.value 50)}}is-warn{{/if}}"
                     data-ih-style-width-pct="{{durabilityPct}}"></div>
              </div>
              {{/if}}
              <span class="ih-cs-inv-weight muted-text">{{system.weight}}кг</span>
              {{#if inventoryActions.length}}
              <div class="ih-cs-inv-actions">
                {{#each inventoryActions}}
                  {{#if enabled}}
                  <a class="{{className}}" data-item-action="{{key}}" data-item-id="{{../id}}" title="{{title}}"><i class="{{iconClass}}"></i></a>
                  {{else}}
                  <a class="{{className}} is-disabled" title="{{title}}"><i class="{{iconClass}}"></i></a>
                  {{/if}}
                {{/each}}
              </div>
              {{/if}}
            </div>
            {{/each}}
          </div>
          {{/if}}
          {{/each}}
          {{!-- Кнопка открыть инвентарь --}}
          <div class="ih-cs-inv-open-btn">
            <a class="ih-btn" data-open-inventory>🎒 Открыть инвентарь</a>
          </div>
        </div>
      </div>

    </div>

  </div>

  {{!-- ФРАКЦИИ ─────────────────────────────────────────────────── --}}
  <div class="ih-cs-factions">
    <div class="ih-cs-section-header">
      <div class="ih-cs-section-title">⚔ Репутация</div>
      {{#if isGM}}
      <a class="ih-btn ih-btn-small" data-action="edit-reputation" title="Изменить репутацию">✏</a>
      {{/if}}
    </div>
    {{#if factions.length}}
    <div class="ih-cs-faction-list" data-rep-list>
      {{#each factions}}
      {{!-- Показываем первые 5, остальные скрыты --}}
      <div class="ih-cs-faction-row {{#if (gt @index 4)}}ih-rep-hidden{{/if}}"
           title="{{factionName}}: {{rep}}">
        <span class="ih-cs-faction-name">{{factionName}}</span>
        <div class="ih-cs-rep-bar">
          <div class="ih-cs-rep-fill" data-ih-style-width-pct="{{pct}}" data-ih-style-background="{{level.color}}"></div>
          <div class="ih-cs-rep-zero"></div>
        </div>
        <span class="ih-cs-rep-label" data-ih-style-color="{{level.color}}">{{level.label}}</span>
        <span class="ih-cs-rep-val muted-text">{{rep}}</span>
        {{#if @root.isGM}}
        <a class="ih-cs-rep-edit" data-edit-rep="{{factionId}}" title="Изменить">✏</a>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{#if (gt factions.length 5)}}
    <a class="ih-cs-rep-toggle muted-text" data-rep-toggle>
      ▼ Показать все ({{factions.length}})
    </a>
    {{/if}}
    {{else}}
    <div class="muted-text ih-cs-faction-empty">
      Нет взаимодействий с фракциями.
      {{#if isGM}}<a class="ih-cs-rep-add-link" data-action="edit-reputation">Добавить ✏</a>{{/if}}
    </div>
    {{/if}}
  </div>

</form>
