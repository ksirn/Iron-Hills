{{!-- Iron Hills — NPC Sheet v2 --}}
<form class="ih-npc-v2" autocomplete="off">

  {{!-- Шапка --}}
  <div class="ih-npc-v2-header">
    <img class="ih-npc-v2-portrait" src="{{actor.img}}" alt="{{actor.name}}">
    <div class="ih-npc-v2-identity">
      <input class="ih-npc-v2-name" type="text" name="name" value="{{actor.name}}">
      <div class="ih-npc-v2-meta">
        {{#unless isCreature}}
        <label>Роль
          <input type="text" name="system.info.role" value="{{system.info.role}}" placeholder="Страж...">
        </label>
        <label>Специализация
          <input type="text" name="system.info.specialization" value="{{system.info.specialization}}" placeholder="guard">
        </label>
        {{/unless}}
        <label>Ступень
          <input type="number" name="system.info.tier" value="{{system.info.tier}}" min="1" max="10" placeholder="{{#if isCreature}}1–10{{else}}…{{/if}}">
        </label>
        <label>Фракция
          <input type="text" name="system.info.faction" value="{{system.info.faction}}" placeholder="—">
        </label>
      </div>
      <div class="ih-npc-v2-resources">
        <div class="ih-npc-v2-res">
          <span class="ih-npc-v2-res-icon is-energy" title="Энергия / Макс / База">⚡</span>
          <input type="number" name="system.resources.energy.value" value="{{energy.value}}" min="0">
          <span class="muted-text">/</span>
          <input type="number" name="system.resources.energy.max" value="{{energy.max}}" min="0">
          <span class="muted-text ih-npc-v2-base-max" title="Базовый максимум (до боя)">({{energy.baseMax}})</span>
        </div>
        <div class="ih-npc-v2-res">
          <span class="ih-npc-v2-res-icon is-mana">✦</span>
          <input type="number" name="system.resources.mana.value" value="{{mana.value}}" min="0">
          <span class="muted-text">/</span>
          <input type="number" name="system.resources.mana.max" value="{{mana.max}}" min="0">
        </div>
      </div>
    </div>
  </div>

  {{!-- Табы --}}
  <nav class="ih-npc-tabs">
    <a class="ih-npc-tab" data-tab="stats">⚔ Статы</a>
    <a class="ih-npc-tab" data-tab="hp">❤ HP</a>
    <a class="ih-npc-tab" data-tab="items">🎒 Снаряжение</a>
    <a class="ih-npc-tab" data-tab="info">📋 Инфо</a>
  </nav>

  <div class="ih-npc-body">

    {{!-- Вкладка: Навыки --}}
    <div class="ih-npc-tab-panel" data-panel="stats">
      <div class="ih-npc-v2-section">
        <div class="ih-npc-v2-section-title">
          Навыки
          {{#if isGM}}<a class="ih-cs-section-action" data-add-skill>+ Добавить</a>{{/if}}
        </div>
        {{#if skillGroups.length}}
          {{#each skillGroups}}
          <div class="ih-npc-v2-skill-group">
            <div class="ih-npc-v2-skill-group-label">{{label}}</div>
            {{#each skills}}
            <div class="ih-npc-v2-skill-row">
              <span class="ih-npc-v2-skill-name">{{label}}</span>
              <div class="ih-cs-skill-exp-track">
                <div class="ih-cs-skill-exp-fill" data-ih-style-width-pct="{{exp}}"></div>
              </div>
              <input class="ih-npc-v2-skill-val" type="number"
                     name="system.skills.{{key}}.value" value="{{value}}" min="0" max="10">
              <span class="muted-text ih-npc-v2-skill-die">d{{dieSize}}</span>
            </div>
            {{/each}}
          </div>
          {{/each}}
        {{else}}
          <div class="muted-text ih-npc-v2-empty-note">
            Нет навыков{{#if isGM}} — нажми + Добавить{{/if}}
          </div>
        {{/if}}
      </div>
      {{#if isCreature}}
      <div class="ih-npc-v2-section">
        <div class="ih-npc-v2-section-title">Броня и резисты</div>
        <div class="ih-npc-resist-grid">
          {{#each monsterResistanceOptions}}
          <label class="ih-npc-resist-field">
            <span>{{label}}</span>
            <input type="number" name="system.resources.armor.{{key}}" value="{{value}}" min="0">
          </label>
          {{/each}}
        </div>
      </div>
      {{/if}}
    </div>

    {{!-- Вкладка: HP --}}
    <div class="ih-npc-tab-panel" data-panel="hp">
      <div class="ih-npc-v2-section">
        <div class="ih-npc-v2-section-title">Части тела</div>
        {{#each bodyParts}}
        <div class="ih-cs-zone {{#if (lt pct 30)}}is-critical{{else if (lt pct 60)}}is-bad{{/if}}">
          <span class="ih-cs-zone-label">{{label}}</span>
          <div class="ih-cs-zone-bar-track">
            <div class="ih-cs-zone-bar" data-ih-style-width-pct="{{pct}}"></div>
          </div>
          <div class="ih-cs-zone-hp">
            <input class="ih-cs-hp-input" type="number"
                   name="system.resources.hp.{{key}}.value" value="{{value}}" min="0">
            <span class="muted-text">/</span>
            <input class="ih-cs-hp-input" type="number"
                   name="system.resources.hp.{{key}}.max" value="{{max}}" min="0">
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    {{!-- Вкладка: Снаряжение --}}
    <div class="ih-npc-tab-panel" data-panel="items">
      <div class="ih-npc-v2-section">
        <div class="ih-npc-v2-section-title">
          Снаряжение ({{items.length}})
          <a class="ih-cs-section-action" data-open-inventory>Открыть инвентарь</a>
        </div>
        {{#if items.length}}
          {{#each groupedItems}}
          {{#if items.length}}
          <div class="ih-cs-inv-group">
            <div class="ih-cs-inv-group-title">{{label}}</div>
            {{#each items}}
            <div class="ih-cs-inv-row ih-cs-inv-row-simple">
              <img class="ih-cs-inv-icon" src="{{img}}" alt="{{name}}">
              <span class="ih-cs-inv-name is-openable" data-open-item data-item-id="{{id}}">{{name}}</span>
              {{#if system.quantity}}<span class="ih-cs-inv-qty">×{{system.quantity}}</span>{{/if}}
              {{#if system.durability}}
              <div class="ih-cs-inv-dur-track" title="Прочность: {{system.durability.value}}/{{system.durability.max}}">
                <div class="ih-cs-inv-dur-fill {{#if (lt system.durability.value 25)}}is-crit{{else if (lt system.durability.value 50)}}is-warn{{/if}}"
                     data-ih-style-width-pct="{{durabilityPct}}"></div>
              </div>
              {{/if}}
              <span class="muted-text ih-cs-inv-type">{{type}}</span>
              <span class="ih-cs-inv-weight muted-text">{{system.weight}}кг</span>
              {{#if inventoryActions.length}}
              <div class="ih-cs-inv-actions">
                {{#each inventoryActions}}
                  {{#if enabled}}
                  <a class="{{className}}" data-item-action="{{key}}" data-item-id="{{../id}}" title="{{title}}"><i class="{{iconClass}}"></i></a>
                  {{else}}
                  <a class="{{className}} is-disabled" title="{{title}}"><i class="{{iconClass}}"></i></a>
                  {{/if}}
                {{/each}}
              </div>
              {{/if}}
              <a class="ih-icon-btn tiny" data-open-item data-item-id="{{id}}" title="Открыть"><i class="fas fa-book-open"></i></a>
              {{#if @root.isGM}}
              <a class="ih-icon-btn tiny" data-delete-item data-item-id="{{id}}" title="Удалить"><i class="fas fa-times"></i></a>
              {{/if}}
            </div>
            {{/each}}
          </div>
          {{/if}}
          {{/each}}
        {{else}}
          <div class="muted-text ih-npc-v2-empty-note">Нет предметов</div>
        {{/if}}
      </div>
    </div>

    {{!-- Вкладка: Информация --}}
    <div class="ih-npc-tab-panel" data-panel="info">
      {{#if showMonsterLootUi}}
      <div class="ih-npc-v2-section">
        <div class="ih-npc-v2-section-title">Разделка (монстр)</div>
        <p class="muted-text ih-npc-info-note">
          Ключ пула из <code>monster-loot-pools.mjs</code>; по нему синхронизируются встроенные слоты добычи (шанс при разделке).
          Если пусто — подставляется пул по <b>ID бестиария</b>.
        </p>
        {{#if monsterLootGmWarning}}
        <p class="ih-npc-gm-warning">{{monsterLootGmWarning}}</p>
        {{/if}}
        <label class="ih-npc-info-field">Пул добычи разделки
          <input type="text" name="system.info.lootPool" list="ih-monster-loot-pool-datalist"
                 value="{{system.info.lootPool}}"
                 placeholder="{{monsterBestiaryCanon}} или пусто = из бестиария"
                 class="ih-npc-info-input">
        </label>
        {{#if monsterLootPoolKeys.length}}
        <datalist id="ih-monster-loot-pool-datalist">
          {{#each monsterLootPoolKeys}}<option value="{{this}}"></option>{{/each}}
        </datalist>
        {{/if}}
        <label class="ih-npc-info-field">ID бестиария <span class="muted-text">(ключ строки компендиума)</span>
          <input class="ih-npc-info-input" type="text" name="system.info.bestiaryId" value="{{system.info.bestiaryId}}" placeholder="river_maw_spawn">
        </label>
        <p class="muted-text ih-npc-info-subnote">
          Живого монстра нельзя разделать или обыскать. Мёртвого — через «Обыск»: «Выживание», набор разделки и DC по ступени.
        </p>
      </div>
      {{/if}}
      {{#if showNpcObyskUi}}
      <div class="ih-npc-v2-section">
        <div class="ih-npc-v2-section-title">Обыск и карманничество (NPC)</div>
        <p class="muted-text ih-npc-info-note is-spaced">
          Лут — только предметы на этом листе. С мёртвого тела игрок забирает всё без бросков (кнопка в «Обыск» или перетаскивание).
          С живого — попытка карманничества по «Скрытности».
        </p>
        <label class="ih-npc-checkbox-field">
          <input type="checkbox" name="system.info.allowPickpocket" {{checked allowPickpocketEnabled}} data-dtype="Boolean">
          Разрешить карманничество у живой цели
        </label>
        <p class="muted-text ih-npc-info-subnote">
          Поля <code>lootTable</code> / <code>pickpocketTable</code> для NPC не участвуют в механике; их можно не трогать.
        </p>
      </div>
      {{/if}}
      <div class="ih-npc-v2-section">
        <div class="ih-npc-v2-section-title">Описание</div>
        <textarea class="ih-npc-info-textarea" name="system.info.desc"
                  placeholder="{{#if isCreature}}Краткое описание твари…{{else}}Описание NPC...{{/if}}">{{system.info.desc}}</textarea>
      </div>
      <div class="ih-npc-v2-section">
        <div class="ih-npc-v2-section-title">Заметки GM</div>
        <textarea class="ih-npc-info-textarea is-notes" name="system.info.notes"
                  placeholder="Заметки...">{{system.info.notes}}</textarea>
      </div>
    </div>

  </div>
</form>
