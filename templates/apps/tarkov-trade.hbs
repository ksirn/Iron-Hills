{{!-- Iron Hills — Tarkov Trade --}}
<div class="tt-app">

  <div class="tt-dashboard {{tradeDashboard.cssClass}}">
    <div class="tt-dash-party">
      <img src="{{tradeDashboard.merchant.img}}" alt="{{tradeDashboard.merchant.name}}">
      <div>
        <span>Торговец</span>
        <b>{{tradeDashboard.merchant.name}}</b>
        <em>{{tradeDashboard.merchant.coins}}</em>
      </div>
    </div>

    <div class="tt-dash-flow">
      <div class="tt-dash-flow-head">
        <span>Курс x{{tradeDashboard.priceFactor}}</span>
        <b class="{{tradeDashboard.status.cssClass}}">{{tradeDashboard.status.label}}</b>
      </div>
      <div class="tt-dash-flow-grid">
        <span><b>{{tradeDashboard.exchange.buyerGetsQty}}</b> игроку</span>
        <span><b>{{tradeDashboard.exchange.buyerPaysStr}}</b> платит игрок</span>
        <span><b>{{tradeDashboard.exchange.merchantGetsQty}}</b> торговцу</span>
        <span><b>{{tradeDashboard.exchange.merchantPaysStr}}</b> платит торговец</span>
      </div>
    </div>

    <div class="tt-dash-party is-right">
      <div>
        <span>Игрок</span>
        <b>{{tradeDashboard.buyer.name}}</b>
        <em>{{tradeDashboard.buyer.coins}}</em>
      </div>
      <img src="{{tradeDashboard.buyer.img}}" alt="{{tradeDashboard.buyer.name}}">
    </div>

    <div class="tt-dash-chips">
      {{#each tradeDashboard.chips}}
      <span class="tt-dash-chip {{cssClass}}">
        <i class="fas {{icon}}"></i>
        <b>{{label}}</b>
        {{value}}
      </span>
      {{/each}}
    </div>
  </div>

  {{!-- Шапки --}}
  <div class="tt-headers">
    <div class="tt-col-header">
      <img class="tt-party-img" src="{{merchantImg}}" width="28" height="28">
      <div>
        <div class="tt-party-name">{{merchantName}}</div>
        <div class="muted-text tt-party-meta">🪙 {{merchantCoins}} · ×{{priceFactor}}</div>
      </div>
    </div>
    <div class="tt-middle-header">⇄</div>
    <div class="tt-col-header is-right">
      <div class="tt-party-info is-right">
        <div class="tt-party-name">{{buyerName}}</div>
        <div class="muted-text tt-party-meta">🪙 {{buyerCoins}}</div>
      </div>
      <img class="tt-party-img" src="{{buyerImg}}" width="28" height="28">
    </div>
  </div>

  <div class="tt-body">

    {{!-- Грид торговца --}}
    <div class="tt-col">
      <div class="tt-search-bar">
        <input class="tt-search" type="text" placeholder="🔍 Поиск..."
               value="{{mSearch}}" data-search-m>
        <div class="tt-filters">
          {{#each mCats}}
          <a class="tt-filter-btn {{#if active}}is-active{{/if}}"
             data-filter-m="{{key}}">{{label}}</a>
          {{/each}}
        </div>
      </div>
      <div class="tt-grid-wrap">
        <div class="tt-grid"
             data-ih-style-width-px="{{mGrid.gridW}}"
             data-ih-style-height-px="{{mGrid.gridH}}">
          {{#each mGrid.cells}}
          <div class="tt-cell"
               data-ih-style-left-px="{{x}}"
               data-ih-style-top-px="{{y}}"
               data-ih-style-width-px="{{size}}"
               data-ih-style-height-px="{{size}}"></div>
          {{/each}}
          {{#each mGrid.placed}}
          <div class="tt-item" draggable="true"
               data-item-id="{{item.id}}" data-side="merchant"
               data-ih-style-left-px="{{cssLeft}}"
               data-ih-style-top-px="{{cssTop}}"
               data-ih-style-width-px="{{cssW}}"
               data-ih-style-height-px="{{cssH}}">
            <img src="{{item.img}}" alt="{{item.name}}">
            <span class="tt-item-name">{{item.name}}</span>
            {{#if showQty}}<span class="tt-item-qty">×{{qty}}</span>{{/if}}
            <span class="tt-item-price">{{priceStr}}</span>
            {{!-- Tooltip --}}
            <div class="tt-tooltip">
              <div class="tt-tip-header">
                <img src="{{item.img}}" width="24" height="24">
                <div>
                  <div class="tt-tip-name">{{item.name}}</div>
                  <div class="muted-text tt-tip-tier">Тир {{tier}}</div>
                </div>
              </div>
              {{#if tooltipStats}}<div class="tt-tip-stats">{{tooltipStats}}</div>{{/if}}
              {{#if tooltipDesc}}<div class="tt-tip-desc">{{tooltipDesc}}</div>{{/if}}
              <div class="tt-tip-price">🪙 {{priceStr}}</div>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>

    {{!-- Центр: предложения и кнопки --}}
    <div class="tt-center">

      {{!-- Offer торговца --}}
      <div class="tt-offer-zone" data-target="merchant">
        <div class="tt-offer-label">Отдаёт торговец</div>
        {{#each offer}}
        <div class="tt-offer-row">
          <img src="{{img}}" width="20" height="20">
          <span class="tt-offer-name">{{name}}</span>
          <div class="tt-qty-ctrl">
            <a class="tt-qty-btn tt-qty-dec" data-item-id="{{itemId}}" data-side="merchant">−</a>
            <span>{{qty}}</span>
            <a class="tt-qty-btn tt-qty-inc" data-item-id="{{itemId}}" data-side="merchant">+</a>
          </div>
          <span class="tt-offer-price">{{priceStr}}</span>
          <a class="tt-remove" data-remove-offer data-item-id="{{itemId}}" data-side="merchant">✕</a>
        </div>
        {{else}}
        <div class="tt-offer-empty muted-text">Перетащи сюда</div>
        {{/each}}
        {{!-- Монеты торговца --}}
        <div class="tt-coins-block">
          <span class="muted-text tt-coins-label">Монеты торговца</span>
          <div class="tt-coins-row">
            <span class="tt-coin-icon copper">●</span>
            <input class="tt-coins-input" type="number" min="0"
                   value="{{mCopperOffer}}" data-m-coins="copper" placeholder="0">
            <span class="tt-coin-icon silver">●</span>
            <input class="tt-coins-input" type="number" min="0"
                   value="{{mSilverOffer}}" data-m-coins="silver" placeholder="0">
            <span class="tt-coin-icon gold">●</span>
            <input class="tt-coins-input" type="number" min="0"
                   value="{{mGoldOffer}}" data-m-coins="gold" placeholder="0">
          </div>
        </div>
        {{#if offer.length}}
        <div class="tt-offer-total">Итого: {{offerTotalStr}}</div>
        {{/if}}
      </div>

      {{!-- Баланс и кнопки --}}
      <div class="tt-actions">
        <div class="tt-balance {{#if balanced}}balanced{{/if}}">
          {{balanceSign}} {{balanceStr}}
        </div>
        {{#if tradeBlockedReason}}
        <div class="tt-trade-blocked">{{tradeBlockedReason}}</div>
        {{/if}}
        <a class="ih-btn ih-btn-primary" data-accept>✓ Принять</a>
        {{#if isGM}}
        <a class="ih-btn" data-accept-gm>✓ GM (без денег)</a>
        {{/if}}
        <a class="ih-btn" data-reset>✕ Сброс</a>
      </div>

      {{!-- Offer игрока --}}
      <div class="tt-offer-zone" data-target="player">
        <div class="tt-offer-label">Отдаёт игрок</div>
        {{#each playerOffer}}
        <div class="tt-offer-row">
          <img src="{{img}}" width="20" height="20">
          <span class="tt-offer-name">{{name}}</span>
          <div class="tt-qty-ctrl">
            <a class="tt-qty-btn tt-qty-dec" data-item-id="{{itemId}}" data-side="player">−</a>
            <span>{{qty}}</span>
            <a class="tt-qty-btn tt-qty-inc" data-item-id="{{itemId}}" data-side="player">+</a>
          </div>
          <span class="tt-offer-price">{{priceStr}}</span>
          <a class="tt-remove" data-remove-offer data-item-id="{{itemId}}" data-side="player">✕</a>
        </div>
        {{else}}
        <div class="tt-offer-empty muted-text">Перетащи сюда</div>
        {{/each}}
        {{!-- Монеты игрока --}}
        <div class="tt-coins-block">
          <span class="muted-text tt-coins-label">Монеты игрока</span>
          <div class="tt-coins-row">
            <span class="tt-coin-icon copper">●</span>
            <input class="tt-coins-input" type="number" min="0"
                   value="{{pCopperOffer}}" data-p-coins="copper" placeholder="0">
            <span class="tt-coin-icon silver">●</span>
            <input class="tt-coins-input" type="number" min="0"
                   value="{{pSilverOffer}}" data-p-coins="silver" placeholder="0">
            <span class="tt-coin-icon gold">●</span>
            <input class="tt-coins-input" type="number" min="0"
                   value="{{pGoldOffer}}" data-p-coins="gold" placeholder="0">
          </div>
        </div>
        {{#if playerOffer.length}}
        <div class="tt-offer-total">Итого: {{playerOfferTotalStr}}</div>
        {{/if}}
      </div>

    </div>

    {{!-- Грид игрока --}}
    <div class="tt-col">
      <div class="tt-search-bar">
        <input class="tt-search" type="text" placeholder="🔍 Поиск..."
               value="{{pSearch}}" data-search-p>
        <div class="tt-filters">
          {{#each pCats}}
          <a class="tt-filter-btn {{#if active}}is-active{{/if}}"
             data-filter-p="{{key}}">{{label}}</a>
          {{/each}}
        </div>
      </div>
      <div class="tt-grid-wrap">
        <div class="tt-grid"
             data-ih-style-width-px="{{pGrid.gridW}}"
             data-ih-style-height-px="{{pGrid.gridH}}">
          {{#each pGrid.cells}}
          <div class="tt-cell"
               data-ih-style-left-px="{{x}}"
               data-ih-style-top-px="{{y}}"
               data-ih-style-width-px="{{size}}"
               data-ih-style-height-px="{{size}}"></div>
          {{/each}}
          {{#each pGrid.placed}}
          <div class="tt-item" draggable="true"
               data-item-id="{{item.id}}" data-side="player"
               data-ih-style-left-px="{{cssLeft}}"
               data-ih-style-top-px="{{cssTop}}"
               data-ih-style-width-px="{{cssW}}"
               data-ih-style-height-px="{{cssH}}">
            <img src="{{item.img}}" alt="{{item.name}}">
            <span class="tt-item-name">{{item.name}}</span>
            {{#if showQty}}<span class="tt-item-qty">×{{qty}}</span>{{/if}}
            <span class="tt-item-price">{{priceStr}}</span>
            {{!-- Tooltip --}}
            <div class="tt-tooltip">
              <div class="tt-tip-header">
                <img src="{{item.img}}" width="24" height="24">
                <div>
                  <div class="tt-tip-name">{{item.name}}</div>
                  <div class="muted-text tt-tip-tier">Тир {{tier}}</div>
                </div>
              </div>
              {{#if tooltipStats}}<div class="tt-tip-stats">{{tooltipStats}}</div>{{/if}}
              {{#if tooltipDesc}}<div class="tt-tip-desc">{{tooltipDesc}}</div>{{/if}}
              <div class="tt-tip-price">🪙 {{priceStr}}</div>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
    </div>

  </div>
</div>
