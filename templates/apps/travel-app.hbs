<div class="ih-travel-app ih-travel-v2">

  <section class="ih-travel-hero" data-ih-style-border-color="{{groupColor}}">
    <div class="ih-travel-hero-shade"></div>
    <div class="ih-travel-hero-content">
      <div class="ih-travel-hero-main">
        <div class="ih-travel-section-kicker">Маршрут и время</div>
        <h2>{{groupLabel}}</h2>
        <div class="ih-travel-hero-meta">
          <span class="ih-travel-group-dot" data-ih-style-background="{{groupColor}}"></span>
          <span>{{groupLocation}}</span>
          <span>{{partySummary.memberCount}} чел.</span>
          {{#if hasWarnings}}<span class="is-warn">{{warningCount}} предупрежд.</span>{{/if}}
        </div>
      </div>
      <div class="ih-travel-hero-clock">
        <span>{{durationLabel}}</span>
        <b>{{activeActivity.label}}</b>
      </div>
    </div>
  </section>

  <section class="ih-travel-section ih-travel-control-section">
    <div class="ih-travel-section-title">Группа</div>
    <div class="ih-travel-group-row">
      <select class="ih-travel-group-select" data-group-select>
        <option value="">Все персонажи игроков</option>
        {{#each groups}}
        <option value="{{id}}" {{#if (eq id ../groupId)}}selected{{/if}}>
          {{label}} ({{#if isActive}}активна{{else}}неактивна{{/if}})
        </option>
        {{/each}}
      </select>
    </div>

    {{#if hasOtherGroups}}
    <div class="ih-travel-other-groups">
      {{#each otherGroups}}
      <div class="ih-travel-other-group">
        <span class="ih-travel-group-dot" data-ih-style-background="{{color}}"></span>
        <span>{{label}}</span>
        {{#if location}}<span class="muted-text">@ {{location}}</span>{{/if}}
        <span class="muted-text">{{localHours}}ч · {{memberCount}} чел.</span>
      </div>
      {{/each}}
    </div>
    {{/if}}
  </section>

  <section class="ih-travel-section ih-travel-activity-section">
    <div class="ih-travel-section-title">
      Активность
      <a class="ih-travel-camp-toggle {{#if campMode}}is-active{{/if}}" data-toggle-camp>
        {{#if campMode}}Общий режим{{else}}Индивидуальный привал{{/if}}
      </a>
    </div>
    {{#unless campMode}}
    <div class="ih-travel-activities">
      {{#each activities}}
      <a class="ih-travel-act tone-{{tone}} {{#if isActive}}is-active{{/if}}"
         data-activity="{{key}}">
        <span class="ih-travel-act-label">{{label}}</span>
        <span class="ih-travel-act-hint">{{costHint}}</span>
      </a>
      {{/each}}
    </div>
    {{/unless}}
  </section>

  <section class="ih-travel-section ih-travel-time-section">
    <div class="ih-travel-section-title">
      Время
      <span class="ih-travel-hours-display"><b data-hours-label>{{hours}}</b>ч <b data-mins-label>{{mins}}</b>м</span>
    </div>
    <div class="ih-travel-clock-panel">
      <div class="ih-travel-clock-face">
        <span>{{durationLabel}}</span>
        <small>{{totalHours}} ч</small>
      </div>
      <div class="ih-travel-time-controls">
        <div class="ih-wa-set-row ih-travel-time-row">
          <label class="ih-wa-set-label">Ч</label>
          <div class="ih-wa-stepper">
            <a class="ih-wa-step-btn" data-step-hours="-1">−</a>
            <input class="ih-wa-set-input" data-hours-direct type="number" min="0" max="72" value="{{hours}}">
            <a class="ih-wa-step-btn" data-step-hours="1">+</a>
          </div>
        </div>
        <div class="ih-wa-set-row ih-travel-time-row is-last">
          <label class="ih-wa-set-label">М</label>
          <div class="ih-wa-stepper">
            <a class="ih-wa-step-btn" data-step-mins="-10">−</a>
            <input class="ih-wa-set-input" data-mins-direct type="number" min="0" max="59" value="{{mins}}">
            <a class="ih-wa-step-btn" data-step-mins="10">+</a>
          </div>
        </div>
      </div>
    </div>
    <div class="ih-travel-presets">
      <a class="ih-btn ih-btn-small" data-preset-hours="0" data-preset-mins="10">10м</a>
      <a class="ih-btn ih-btn-small" data-preset-hours="0" data-preset-mins="30">30м</a>
      <a class="ih-btn ih-btn-small" data-preset-hours="1" data-preset-mins="0">1ч</a>
      <a class="ih-btn ih-btn-small" data-preset-hours="4" data-preset-mins="0">4ч</a>
      <a class="ih-btn ih-btn-small" data-preset-hours="8" data-preset-mins="0">8ч</a>
      <a class="ih-btn ih-btn-small" data-preset-hours="24" data-preset-mins="0">Сутки</a>
    </div>
  </section>

  {{#if hasMembers}}
  <section class="ih-travel-section ih-travel-roster-section">
    <div class="ih-travel-section-title">Персонажи ({{preview.length}})</div>
    <div class="ih-travel-chars">
      {{#each preview}}
      <article class="ih-travel-char {{#if hasWarning}}has-warning{{/if}}">
        <img class="ih-travel-char-img" src="{{img}}" alt="{{name}}">
        <div class="ih-travel-char-info">
          <div class="ih-travel-char-topline">
            <div>
              <div class="ih-travel-char-name">{{name}}</div>
              <div class="ih-travel-char-act-label">{{activityLabel}}</div>
            </div>
            {{#if statusChips}}
            <div class="ih-travel-status-chips">
              {{#each statusChips}}
              <span class="ih-travel-status-chip {{tone}}">{{label}}</span>
              {{/each}}
            </div>
            {{/if}}
          </div>

          {{#if ../campMode}}
          <div class="ih-travel-camp-acts">
            {{#each ../activities}}
            <a class="ih-btn ih-btn-small ih-travel-camp-act {{#if (eq ../activityKey key)}}ih-btn-primary{{/if}}"
               data-camp-activity="{{key}}" data-actor-id="{{../actorId}}">{{label}}</a>
            {{/each}}
          </div>
          {{/if}}

          <div class="ih-travel-vitals">
            {{#each resourceRows}}
            <div class="ih-travel-vital {{tone}}">
              <span class="ih-travel-vital-icon">{{icon}}</span>
              <span class="ih-travel-vital-label">{{label}}</span>
              <div class="ih-travel-bar-track">
                <div class="ih-travel-bar-fill {{fillClass}}" data-ih-style-width-pct="{{pct}}"></div>
              </div>
              <span class="ih-travel-vital-value">{{valueText}}</span>
              <span class="ih-travel-bar-delta {{deltaClass}}">{{deltaText}}</span>
            </div>
            {{/each}}
          </div>
        </div>
      </article>
      {{/each}}
    </div>
  </section>
  {{else}}
  <div class="ih-travel-empty">Нет персонажей в группе</div>
  {{/if}}

  <div class="ih-travel-actions">
    {{#if campMode}}
    <a class="ih-btn ih-btn-primary ih-travel-action-primary" data-apply-rest>
      Применить привал {{durationLabel}}
    </a>
    {{else}}
    <a class="ih-btn ih-btn-primary ih-travel-action-primary" data-apply-time>
      Применить {{activeActivity.label}} · {{durationLabel}}
    </a>
    {{/if}}
  </div>

</div>
