{{!-- Iron Hills World Tools — вкладочный интерфейс --}}
<div class="ih-wt">

  {{!-- Навигация по вкладкам --}}
  <nav class="ih-wt-tabs">
    <a class="ih-wt-tab is-active" data-tab="settlements">🏘 Поселения</a>
    <a class="ih-wt-tab" data-tab="merchants">🏪 Торговцы</a>
    <a class="ih-wt-tab" data-tab="poi">🗺 POI</a>
    <a class="ih-wt-tab" data-tab="factions">⚔ Фракции</a>
    <a class="ih-wt-tab" data-tab="quests">📜 Квесты</a>
    <a class="ih-wt-tab" data-tab="npc">👤 NPC</a>
    <a class="ih-wt-tab" data-tab="simulation">🌍 Симуляция</a>
    <a class="ih-wt-tab" data-tab="release">✓ Release QA</a>
  </nav>

  {{!-- ══════════════════════════════════════════════════════ --}}
  {{!-- ВКЛАДКА: ПОСЕЛЕНИЯ --}}
  {{!-- ══════════════════════════════════════════════════════ --}}
  <div class="ih-wt-panel is-active" data-panel="settlements">
    <div class="ih-wt-grid">

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">🏘 Создать поселение</div>
        <div class="ih-wt-fields">
          <label>Название
            <input type="text" name="settlement-name" placeholder="Оукхолл">
          </label>
          <label>Регион
            <select name="settlement-region">
              <option value="Iron Hills">Iron Hills (тир 1-3)</option>
              {{#each regions}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
              <option value="__new">+ Новый регион...</option>
            </select>
          </label>
          <div class="ih-wt-new-region">
            <label>Название нового региона
              <input type="text" name="settlement-region-new" placeholder="Название региона">
            </label>
          </div>
          <label>Тир (1-10)
            <select name="settlement-tier">
              <option value="1">1 — Деревня (медь)</option>
              <option value="2">2 — Посёлок (бронза)</option>
              <option value="3">3 — Малый город (железо)</option>
              <option value="4">4 — Город (сталь)</option>
              <option value="5">5 — Крупный город</option>
              <option value="6">6 — Торговый центр</option>
              <option value="7">7 — Столица региона (митрил)</option>
              <option value="8">8 — Имперский город</option>
              <option value="9">9 — Древний город</option>
              <option value="10">10 — Легендарный</option>
            </select>
          </label>
          <label>Фракция контроля
            <input type="text" name="settlement-faction" placeholder="Название фракции">
          </label>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn ih-btn-primary" data-action="create-settlement">✨ Создать</a>
        </div>
      </div>

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">📊 Тик поселения</div>
        <div class="ih-wt-fields">
          <label>Поселение
            <select name="tick-settlement">
              {{#each settlements}}
              <option value="{{id}}">{{name}}</option>
              {{/each}}
            </select>
          </label>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn" data-action="advance-settlement">⏩ Недельный тик</a>
          <a class="ih-btn" data-action="generate-rumor">💬 Слух</a>
        </div>
      </div>

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">🗺 Региональные инструменты</div>
        <div class="ih-wt-fields">
          <label>Регион
            <select name="region-select">
              {{#each regions}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </label>
          <label>Экономика региона
            <select name="region-economy">
              {{#each economyStates}}
              <option value="{{id}}">{{text}}</option>
              {{/each}}
            </select>
          </label>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn" data-action="region-crisis">💥 Кризис</a>
          <a class="ih-btn" data-action="run-caravans">🚛 Караваны</a>
          <a class="ih-btn" data-action="stabilize-region">🕊 Стабилизировать</a>
          <a class="ih-btn" data-action="set-region-economy">💱 Сменить экономику</a>
        </div>
      </div>

    </div>
  </div>

  {{!-- ══════════════════════════════════════════════════════ --}}
  {{!-- ВКЛАДКА: ТОРГОВЦЫ --}}
  {{!-- ══════════════════════════════════════════════════════ --}}
  <div class="ih-wt-panel" data-panel="merchants">
    <div class="ih-wt-grid">

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">🏪 Создать торговца</div>
        <div class="ih-wt-fields">
          <label>Имя (пусто = случайное)
            <input type="text" name="merchant-name" placeholder="Борин Кузнец">
          </label>
          <label>Тип магазина
            <select name="merchant-specialty">
              {{#each merchantTypes}}
              <option value="{{id}}">{{text}}</option>
              {{/each}}
            </select>
          </label>
          <label>Тир поселения (1-10)
            <select name="merchant-tier">
              <option value="1">1 — Деревня (медь)</option>
              <option value="2">2 — Посёлок (бронза)</option>
              <option value="3">3 — Малый город (железо)</option>
              <option value="4">4 — Город (сталь)</option>
              <option value="5">5 — Крупный город</option>
              <option value="6">6 — Торговый центр</option>
              <option value="7">7 — Столица региона (митрил)</option>
              <option value="8">8 — Имперский город</option>
              <option value="9">9 — Древний город</option>
              <option value="10">10 — Легендарный рынок</option>
            </select>
          </label>
          <label>Состояние экономики
            <select name="merchant-economy">
              {{#each economyStates}}
              <option value="{{id}}">{{text}}</option>
              {{/each}}
            </select>
          </label>
          <label>Поселение
            <div class="ih-wt-picker-row">
              <input type="text" name="merchant-settlement" placeholder="Или выбрать →">
              <a class="ih-btn ih-btn-small" data-pick-merchant-settlement>📍</a>
            </div>
          </label>
          <label>Фракция
            <input type="text" name="merchant-faction" value="">
          </label>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn ih-btn-primary" data-action="generate-merchant">✨ Создать и наполнить</a>
          <a class="ih-btn" data-action="restock-selected-merchant">🔄 Пополнить выбранного</a>
          <a class="ih-btn" data-action="restock-merchants">🔄 Пополнить всех</a>
        </div>
      </div>

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">📦 Контейнер/Тайник</div>
        <div class="ih-wt-fields">
          <label>Тема
            <select name="container-theme">
              {{#each containerThemes}}
              <option value="{{id}}">{{text}}</option>
              {{/each}}
            </select>
          </label>
          <label>Тир
            <select name="container-tier">
              <option value="1">1 — Бедный</option>
              <option value="2">2 — Обычный</option>
              <option value="3">3 — Богатый</option>
              <option value="4">4 — Редкий</option>
            </select>
          </label>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn" data-action="generate-container">📦 Создать</a>
        </div>
      </div>

    </div>
  </div>

  {{!-- ══════════════════════════════════════════════════════ --}}
  {{!-- ВКЛАДКА: POI --}}
  {{!-- ══════════════════════════════════════════════════════ --}}
  <div class="ih-wt-panel" data-panel="poi">
    <div class="ih-wt-grid">

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">📍 Создать POI</div>
        <div class="ih-wt-fields">
          <label>Тип
            <select name="poi-type">
              {{#each poiTypes}}
              <option value="{{id}}">{{text}}</option>
              {{/each}}
            </select>
          </label>
          <label>Тир опасности (1-10)
            <select name="poi-tier">
              <option value="1">1 — Новичок (медные орудия)</option>
              <option value="2">2 — Начинающий</option>
              <option value="3">3 — Опытный (железо)</option>
              <option value="4">4 — Умелый (сталь)</option>
              <option value="5">5 — Ветеран</option>
              <option value="6">6 — Элита</option>
              <option value="7">7 — Мастер (митрил)</option>
              <option value="8">8 — Герой</option>
              <option value="9">9 — Легенда</option>
              <option value="10">10 — Эпик (адамантий)</option>
            </select>
          </label>
          <label>Регион
            <select name="poi-region">
              {{#each regions}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </label>
          <label>Ближайшее поселение
            <div class="ih-wt-picker-row">
              <input type="text" name="poi-settlement" placeholder="Или выбрать →">
              <a class="ih-btn ih-btn-small" data-pick-poi-settlement>📍</a>
            </div>
          </label>
          <label>Фракция
            <div class="ih-wt-picker-row">
              <input type="text" name="poi-faction" placeholder="Или выбрать →">
              <a class="ih-btn ih-btn-small" data-pick-faction>📋</a>
            </div>
          </label>
          <div class="ih-wt-field-row">
            <label>Колонка карты
              <input type="number" name="poi-map-col" min="0" max="9" placeholder="авто">
            </label>
            <label>Ряд карты
              <input type="number" name="poi-map-row" min="0" max="9" placeholder="авто">
            </label>
          </div>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn ih-btn-primary" data-action="generate-poi">📍 Создать POI</a>
          <a class="ih-btn" data-action="generate-poi-pack">🗺 Набор POI (5 шт)</a>
          <a class="ih-btn" data-action="generate-regional-threat">⚠ Угроза региона</a>
        </div>
      </div>

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">⚙ Управление POI</div>
        <div class="ih-wt-fields">
          <label class="muted-text ih-wt-note">
            Выдели токены POI на сцене или оставь пустым — применится ко всем
          </label>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn" data-action="evolve-pois">🔄 Эволюция POI</a>
          <a class="ih-btn" data-action="cleanup-pois">🗑 Убрать рухнувшие</a>
          <a class="ih-btn" data-action="map-pois">🧭 Привязать к карте</a>
        </div>
      </div>

      <div class="ih-wt-card ih-wt-card-wide ih-wt-session-prep">
        <div class="ih-wt-card-title">🧭 Подготовка сессии и карты</div>
        <div class="ih-wt-fields">
          <div class="ih-wt-field-row">
            <label>Регион
              <select name="session-region">
                {{#each regions}}
                <option value="{{this}}">{{this}}</option>
                {{/each}}
              </select>
            </label>
            <label>Фокус POI
              <select name="session-poi">
                <option value="">— авто: главная угроза —</option>
                {{#each pois}}
                <option value="{{id}}">{{name}} · {{type}} т{{tier}} {{#if hasMap}}[{{mapCol}},{{mapRow}}]{{/if}}</option>
                {{/each}}
              </select>
            </label>
          </div>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn" data-action="materialize-first-session">🧱 Создать слой Iron Hills</a>
          <a class="ih-btn ih-btn-primary" data-action="generate-first-session-brief">🧭 План первой сессии</a>
          <a class="ih-btn" data-action="generate-first-session-runbook">🎲 GM runbook</a>
          <a class="ih-btn" data-action="generate-first-session-qa">✓ QA слой</a>
          <a class="ih-btn" data-action="generate-combat-qa">⚔ Combat QA</a>
          <a class="ih-btn" data-action="run-combat-dry-run">▶ Combat dry-run</a>
          <a class="ih-btn" data-action="materialize-combat-test-bench">🧪 Combat test bench</a>
          <a class="ih-btn" data-action="generate-session-brief">📋 Session brief</a>
          <a class="ih-btn" data-action="map-pois">🧭 Автопривязка POI</a>
          <a class="ih-btn" data-action="open-world-map">🗺 Открыть карту</a>
        </div>
        {{#if firstSessionSummary}}
        <div class="ih-wt-first-session-summary {{firstSessionSummary.tone}}">
          <div>
            <span>Регион</span>
            <strong>{{firstSessionSummary.region}}</strong>
            <em>{{firstSessionSummary.readiness}}% · {{firstSessionSummary.status}}</em>
          </div>
          <div>
            <span>Сцены</span>
            <strong>{{firstSessionSummary.sceneSlots}}</strong>
            <em>маршрут первой игры</em>
          </div>
          <div>
            <span>NPC</span>
            <strong>{{firstSessionSummary.npcRoles}}</strong>
            <em>роли для размещения</em>
          </div>
          <div>
            <span>Торговля</span>
            <strong>{{firstSessionSummary.merchantSlots}}</strong>
            <em>якоря экономики</em>
          </div>
          <div>
            <span>POI</span>
            <strong>{{firstSessionSummary.mappedPois}}</strong>
            <em>привязано к карте</em>
          </div>
        </div>
        {{/if}}
        {{#if hasFirstSessionRunbook}}
        <div class="ih-wt-session-runbook {{firstSessionRunbook.tone}}">
          <div class="ih-wt-session-runbook-head">
            <strong>{{firstSessionRunbook.scorePct}}%</strong>
            <span>{{firstSessionRunbook.statusLabel}}</span>
            <em>блокеры {{firstSessionRunbook.blockers}} · ручные {{firstSessionRunbook.manualChecks}} · предупреждения {{firstSessionRunbook.warnings}}</em>
          </div>
          <div class="ih-wt-session-runbook-facts">
            <div><strong>{{firstSessionRunbook.facts.settlements}}</strong><span>поселения</span></div>
            <div><strong>{{firstSessionRunbook.facts.mappedPois}}/{{firstSessionRunbook.facts.pois}}</strong><span>POI на карте</span></div>
            <div><strong>{{firstSessionRunbook.facts.merchants}}</strong><span>торговцы</span></div>
            <div><strong>{{firstSessionRunbook.facts.merchantStockItems}}</strong><span>предметы в стоке</span></div>
            <div><strong>{{firstSessionRunbook.facts.npcs}}</strong><span>NPC роли</span></div>
            <div><strong>{{firstSessionRunbook.facts.quests}}</strong><span>квесты</span></div>
          </div>
          <div class="ih-wt-session-runbook-gates">
            {{#each firstSessionRunbook.gates}}
            <div class="ih-wt-session-gate {{tone}}">
              <strong>{{label}}</strong>
              <span>{{statusLabel}}</span>
              <em>{{summary}}</em>
              {{#if action}}<small>{{action}}</small>{{/if}}
            </div>
            {{/each}}
          </div>
          <div class="ih-wt-session-runbook-scenarios">
            {{#each firstSessionRunbook.scenarios}}
            <div class="ih-wt-session-scenario {{tone}}">
              <strong>{{label}}</strong>
              <span>{{statusLabel}} · {{map}}</span>
              <em>{{systemsLabel}}</em>
            </div>
            {{/each}}
          </div>
          {{#if firstSessionRunbook.hasRisks}}
          <div class="ih-wt-session-runbook-risks">
            {{#each firstSessionRunbook.riskLines}}
            <span>{{this}}</span>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if hasFirstSessionQa}}
        <div class="ih-wt-session-qa {{firstSessionQa.tone}}">
          <div class="ih-wt-session-qa-head">
            <strong>{{firstSessionQa.scorePct}}%</strong>
            <span>{{firstSessionQa.statusLabel}}</span>
            <em>документы {{firstSessionQa.facts.foundDocuments}}/{{firstSessionQa.facts.documents}} · связи {{firstSessionQa.facts.linkedDocuments}}/{{firstSessionQa.facts.documents}} · API gaps {{firstSessionQa.facts.apiMissing}}</em>
          </div>
          <div class="ih-wt-session-qa-checks">
            {{#each firstSessionQa.checks}}
            <div class="ih-wt-session-qa-check {{tone}}">
              <strong>{{label}}</strong>
              <span>{{statusLabel}} · {{metric}}</span>
              <em>{{summary}}</em>
            </div>
            {{/each}}
          </div>
          {{#if firstSessionQa.hasNextActions}}
          <div class="ih-wt-session-qa-next">
            {{#each firstSessionQa.nextActions}}
            <span>{{this}}</span>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if hasCombatQa}}
        <div class="ih-wt-combat-qa {{combatQa.tone}}">
          <div class="ih-wt-combat-qa-head">
            <strong>{{combatQa.scorePct}}%</strong>
            <span>{{combatQa.statusLabel}}</span>
            <em>API {{combatQa.facts.apiAvailable}}/{{combatQa.facts.apiTotal}} · механики {{combatQa.facts.mechanicOk}}/{{combatQa.facts.mechanicTotal}} · сценарии {{combatQa.facts.scenarioReady}}/{{combatQa.facts.scenarioTotal}}</em>
          </div>
          <div class="ih-wt-combat-qa-facts">
            <div><strong>{{combatQa.facts.aoeShapes}}/{{combatQa.facts.aoeTypes}}</strong><span>AoE формы/типы</span></div>
            <div><strong>{{combatQa.facts.targetableZones}}</strong><span>AoE зоны тела</span></div>
            <div><strong>{{combatQa.facts.traumaParts}}</strong><span>зоны травм</span></div>
            <div><strong>{{combatQa.facts.runtimeWarnings}}</strong><span>runtime warnings</span></div>
          </div>
          <div class="ih-wt-combat-qa-checks">
            {{#each combatQa.checks}}
            <div class="ih-wt-combat-qa-check {{tone}}">
              <strong>{{label}}</strong>
              <span>{{statusLabel}} · {{metric}}</span>
              <em>{{summary}}</em>
            </div>
            {{/each}}
          </div>
          <div class="ih-wt-combat-qa-scenarios">
            {{#each combatQa.scenarios}}
            <div class="ih-wt-combat-qa-scenario {{tone}}">
              <strong>{{label}}</strong>
              <span>{{statusLabel}} · {{minutes}} мин · {{stepCount}} шага</span>
              <em>{{summary}}</em>
            </div>
            {{/each}}
          </div>
          {{#if combatQa.hasNextActions}}
          <div class="ih-wt-combat-qa-next">
            {{#each combatQa.nextActions}}
            <span>{{this}}</span>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if hasCombatDryRun}}
        <div class="ih-wt-combat-dry-run {{combatDryRun.tone}}">
          <div class="ih-wt-combat-dry-run-head">
            <strong>{{combatDryRun.scorePct}}%</strong>
            <span>{{combatDryRun.statusLabel}}</span>
            <em>последний запуск: {{combatDryRun.lastRunLabel}} · smoke {{combatDryRun.facts.smokeErrors}}/{{combatDryRun.facts.smokeWarnings}} · sections {{combatDryRun.facts.sectionsDone}}/{{combatDryRun.facts.sectionsTotal}}</em>
          </div>
          <div class="ih-wt-combat-dry-run-facts">
            <div><strong>{{combatDryRun.facts.expectedCasesOk}}/{{combatDryRun.facts.expectedCases}}</strong><span>expected cases</span></div>
            <div><strong>{{combatDryRun.facts.sectionBlockers}}</strong><span>section blockers</span></div>
            <div><strong>{{combatDryRun.facts.sectionWarnings}}</strong><span>section warnings</span></div>
            <div><strong>{{combatDryRun.facts.manualScenarios}}</strong><span>manual scenarios</span></div>
          </div>
          <div class="ih-wt-combat-dry-run-sections">
            {{#each combatDryRun.sectionRows}}
            <div class="ih-wt-combat-dry-run-section {{tone}}">
              <strong>{{id}}</strong>
              <span>{{statusLabel}} · {{metric}}</span>
              <em>{{summary}}</em>
            </div>
            {{/each}}
          </div>
          <div class="ih-wt-combat-dry-run-cases">
            {{#each combatDryRun.expectedCases}}
            <div class="ih-wt-combat-dry-run-case {{tone}}">
              <strong>{{label}}</strong>
              <span>{{layer}} · {{autoSection}} · {{statusLabel}}</span>
              <em>{{expected}}</em>
            </div>
            {{/each}}
          </div>
          {{#if combatDryRun.hasNextActions}}
          <div class="ih-wt-combat-dry-run-next">
            {{#each combatDryRun.nextActions}}
            <span>{{this}}</span>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if hasCombatTestBench}}
        <div class="ih-wt-combat-test-bench {{combatTestBench.tone}}">
          <div class="ih-wt-combat-test-bench-head">
            <strong>{{combatTestBench.scorePct}}%</strong>
            <span>{{combatTestBench.statusLabel}}</span>
            <em>actors {{combatTestBench.facts.actorsReady}}/{{combatTestBench.facts.actorsTotal}} · items {{combatTestBench.facts.itemsReady}}/{{combatTestBench.facts.itemsTotal}} · tokens {{combatTestBench.facts.tokensReady}}/{{combatTestBench.facts.tokensTotal}}</em>
          </div>
          <div class="ih-wt-combat-test-bench-facts">
            <div><strong>{{combatTestBench.facts.actorsReady}}/{{combatTestBench.facts.actorsTotal}}</strong><span>actors</span></div>
            <div><strong>{{combatTestBench.facts.itemsReady}}/{{combatTestBench.facts.itemsTotal}}</strong><span>items</span></div>
            <div><strong>{{combatTestBench.facts.tokensReady}}/{{combatTestBench.facts.tokensTotal}}</strong><span>scene tokens</span></div>
            <div><strong>{{combatTestBench.facts.scenarios}}</strong><span>manual checks</span></div>
          </div>
          <div class="ih-wt-combat-test-bench-actors">
            {{#each combatTestBench.actorRows}}
            <div class="ih-wt-combat-test-bench-actor {{tone}}">
              <strong>{{label}}</strong>
              <span>{{statusLabel}} · {{role}}</span>
              <em>{{summary}}</em>
            </div>
            {{/each}}
          </div>
          <div class="ih-wt-combat-test-bench-scene {{combatTestBench.sceneRow.tone}}">
            <strong>{{combatTestBench.sceneRow.label}}</strong>
            <span>{{combatTestBench.sceneRow.statusLabel}} · tokens {{combatTestBench.sceneRow.tokenReady}}/{{combatTestBench.sceneRow.tokenTotal}}</span>
            <em>{{combatTestBench.sceneRow.summary}}</em>
          </div>
          <div class="ih-wt-combat-test-bench-scenarios">
            {{#each combatTestBench.scenarioRows}}
            <div class="ih-wt-combat-test-bench-scenario {{tone}}">
              <strong>{{label}}</strong>
              <span>{{statusLabel}} · {{actor}}</span>
              <em>{{expected}}</em>
            </div>
            {{/each}}
          </div>
          {{#if combatTestBench.hasNextActions}}
          <div class="ih-wt-combat-test-bench-next">
            {{#each combatTestBench.nextActions}}
            <span>{{this}}</span>
            {{/each}}
          </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if hasGmControl}}
        <div class="ih-wt-gm-control {{gmControl.tone}}">
          <div class="ih-wt-gm-control-head">
            <strong>GM</strong>
            <span>{{gmControl.statusLabel}}</span>
            <em>bench {{gmControl.benchCount}} · targets {{gmControl.targetCount}} · combat {{gmControl.participantCount}} · pending {{gmControl.pendingCount}} · time {{gmControl.worldTimeLabel}}</em>
          </div>
          <div class="ih-wt-gm-control-scopes">
            {{#each gmControl.scopeRows}}
            <span class="{{tone}}" title="{{hint}}"><b>{{count}}</b>{{label}}</span>
            {{/each}}
          </div>
          <div class="ih-wt-gm-control-toolbar">
            <label>Цели
              <select name="gm-control-scope">
                {{#each gmControl.scopes}}
                <option value="{{id}}">{{label}} · {{count}}</option>
                {{/each}}
              </select>
            </label>
            <label>Время
              <select name="gm-time-preset">
                {{#each gmControl.timePresets}}
                <option value="{{id}}">{{label}}</option>
                {{/each}}
              </select>
            </label>
            <a class="ih-btn" data-gm-action="advance-time">Сдвинуть время</a>
            <a class="ih-btn" data-gm-action="open-combat-hud">Combat HUD</a>
            <a class="ih-btn" data-gm-action="open-combat-director">Director</a>
            <a class="ih-btn" data-gm-action="open-combat-manager">Manager</a>
            <a class="ih-btn" data-gm-action="open-inventory">Инвентарь</a>
            <a class="ih-btn" data-gm-action="open-world-map">Карта</a>
          </div>
          <div class="ih-wt-gm-control-presets">
            <a class="ih-btn ih-btn-primary" data-gm-action="prepare-combat">Подготовить бой</a>
            <a class="ih-btn" data-gm-action="recover-after-combat">После боя</a>
            <a class="ih-btn" data-gm-action="refresh-action-economy">Секунды + pending</a>
            <a class="ih-btn" data-gm-action="sync-trauma">Синхр. травмы</a>
          </div>
          <div class="ih-wt-gm-control-actions">
            <a class="ih-btn ih-btn-primary" data-gm-action="restore-all">Восстановить всё</a>
            <a class="ih-btn" data-gm-action="restore-vitals">HP/Mana/Energy</a>
            <a class="ih-btn" data-gm-action="repair-gear">Ремонт</a>
            <a class="ih-btn" data-gm-action="clear-conditions">Очистить эффекты</a>
            <a class="ih-btn" data-gm-action="short-rest">Короткий отдых</a>
            <a class="ih-btn" data-gm-action="full-rest">Полный отдых</a>
            <a class="ih-btn" data-gm-action="revive">Оживить</a>
            <a class="ih-btn" data-gm-action="tick-conditions">Tick времени</a>
            <a class="ih-btn" data-gm-action="reset-seconds">Сброс секунд</a>
            <a class="ih-btn" data-gm-action="clear-pending">Очистить pending</a>
            <a class="ih-btn ih-btn-danger" data-gm-action="defeat">Победить/убить</a>
          </div>
          <div class="ih-wt-gm-control-resource">
            <label>Ресурс
              <select name="gm-resource-key">
                {{#each gmControl.resourcePresets}}
                <option value="{{key}}" data-default-mode="{{defaultMode}}" data-default-value="{{defaultValue}}">{{label}}</option>
                {{/each}}
              </select>
            </label>
            <label>Режим
              <select name="gm-resource-mode">
                {{#each gmControl.resourceModes}}
                <option value="{{id}}">{{label}}</option>
                {{/each}}
              </select>
            </label>
            <label>Значение
              <input type="number" name="gm-resource-value" min="0" value="0">
            </label>
            <a class="ih-btn" data-gm-action="apply-resource">Применить</a>
          </div>
          <div class="ih-wt-gm-control-body">
            <label>Зона тела
              <select name="gm-body-part">
                {{#each gmControl.bodyParts}}
                <option value="{{key}}">{{label}}</option>
                {{/each}}
              </select>
            </label>
            <label>Сила
              <input type="number" name="gm-body-amount" min="1" value="5">
            </label>
            <a class="ih-btn ih-btn-danger" data-gm-action="damage-body">Нанести урон</a>
            <a class="ih-btn" data-gm-action="heal-body">Лечить</a>
          </div>
          <div class="ih-wt-gm-control-effect">
            <label>Эффект
              <select name="gm-condition-key">
                {{#each gmControl.conditionPresets}}
                <option value="{{key}}" data-default-value="{{value}}">{{label}} · {{valueKind}}</option>
                {{/each}}
              </select>
            </label>
            <label>Значение
              <input type="number" name="gm-condition-value" min="1" value="1">
            </label>
            <a class="ih-btn" data-gm-action="apply-condition">Наложить</a>
          </div>
          <div class="ih-wt-gm-control-quick">
            <label>Атака / заклинание
              <select name="gm-action-item">
                <option value="">Equipped/unarmed</option>
                {{#each gmControl.actionItems}}
                <option value="{{id}}">{{label}} · {{detail}}</option>
                {{/each}}
              </select>
            </label>
            <label>Рука
              <select name="gm-action-hand">
                <option value="rightHand">Right hand</option>
                <option value="leftHand">Left hand</option>
              </select>
            </label>
            <label>Зона
              <select name="gm-action-target-zone">
                <option value="">Item/default</option>
                {{#each gmControl.bodyParts}}
                <option value="{{key}}">{{label}}</option>
                {{/each}}
              </select>
            </label>
            <label>Режим зоны
              <select name="gm-action-zone-mode">
                {{#each gmControl.targetZoneModes}}
                <option value="{{id}}">{{label}}</option>
                {{/each}}
              </select>
            </label>
            <label>Friendly fire
              <select name="gm-action-friendly-fire">
                {{#each gmControl.friendlyFireModes}}
                <option value="{{id}}">{{label}}</option>
                {{/each}}
              </select>
            </label>
            <label class="ih-wt-gm-control-check">
              <input type="checkbox" name="gm-action-skip-time" checked>
              <span>GM instant</span>
            </label>
            <label class="ih-wt-gm-control-check">
              <input type="checkbox" name="gm-action-aimed">
              <span>Aimed</span>
            </label>
            <a class="ih-btn ih-btn-primary" data-gm-action="quick-action">Атаковать / каст</a>
          </div>
          <div class="ih-wt-gm-control-actors">
            {{#if gmControl.hasActorRows}}
            {{#each gmControl.actorRows}}
            <div class="ih-wt-gm-control-actor {{tone}}">
              <strong>{{name}}</strong>
              <span>{{hpLabel}} · {{energyLabel}} · {{manaLabel}}</span>
              <em>{{conditionsLabel}} · gear {{durabilityLabel}} · {{combatLabel}}</em>
            </div>
            {{/each}}
            {{else}}
            <div class="ih-wt-gm-control-empty">Выдели токены или выбери scope targets/combat/bench. Bench scope работает после создания IH Combat Test Bench.</div>
            {{/if}}
          </div>
        </div>
        {{/if}}
        {{#if hasRegionPrepRows}}
        <div class="ih-wt-region-readiness">
          {{#each regionPrepRows}}
          <div class="ih-wt-region-row {{tone}}">
            <strong>{{region}}</strong>
            <span>{{readiness}}% · {{status}}</span>
            <em>пос. {{settlements}} · POI {{mappedPois}}/{{pois}} · торговцы {{merchants}} · угрозы {{highThreats}}</em>
          </div>
          {{/each}}
        </div>
        {{/if}}
      </div>

    </div>
  </div>

  {{!-- ══════════════════════════════════════════════════════ --}}
  {{!-- ВКЛАДКА: ФРАКЦИИ --}}
  {{!-- ══════════════════════════════════════════════════════ --}}
  <div class="ih-wt-panel" data-panel="factions">
    <div class="ih-wt-grid">

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">⚔ Создать фракцию</div>
        <div class="ih-wt-fields">
          <label>Название
            <input type="text" name="faction-name" placeholder="Гильдия кузнецов">
          </label>
          <label>Тип
            <select name="faction-type">
              <option value="guild">🔨 Гильдия</option>
              <option value="military">⚔ Военная</option>
              <option value="religious">✝ Религиозная</option>
              <option value="criminal">🌑 Криминальная</option>
              <option value="noble">👑 Дворянская</option>
              <option value="merchant">🏪 Торговая</option>
            </select>
          </label>
          <label>Сила (1-10)
            <input type="number" name="faction-power" value="5" min="1" max="10">
          </label>
          <label>Богатство (1-10)
            <input type="number" name="faction-wealth" value="5" min="1" max="10">
          </label>
          <label>Базовое поселение
            <select name="faction-settlement">
              <option value="">— Без базы —</option>
              {{#each settlements}}
              <option value="{{name}}">{{name}}</option>
              {{/each}}
            </select>
          </label>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn ih-btn-primary" data-action="create-faction">✨ Создать фракцию</a>
        </div>
      </div>

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">📊 Отчёт по фракциям</div>
        <div class="ih-wt-actions ih-wt-actions-spaced">
          <a class="ih-btn" data-action="faction-report">📊 Показать отчёт</a>
        </div>
        {{#if factionReport}}
        <table class="ih-wt-table">
          <thead><tr><th>Поселение</th><th>Фракция</th><th>Сила</th><th>Давление</th></tr></thead>
          <tbody>
            {{#each factionReport}}
            <tr>
              <td>{{settlement}}</td>
              <td>{{faction}}</td>
              <td>{{power}}</td>
              <td class="{{#if (gt pressure 0)}}text-good{{else if (lt pressure 0)}}text-bad{{/if}}">
                {{pressure}}
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{/if}}
      </div>

    </div>
  </div>

  {{!-- ══════════════════════════════════════════════════════ --}}
  {{!-- ВКЛАДКА: КВЕСТЫ --}}
  {{!-- ══════════════════════════════════════════════════════ --}}
  <div class="ih-wt-panel" data-panel="quests">
    <div class="ih-wt-grid">

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">📜 Генератор квеста</div>
        <div class="ih-wt-fields">
          <label>Тип квеста
            <select name="quest-type">
              <option value="auto">🎲 Авто</option>
              <option value="gathering">🌿 Сбор/Добыча</option>
              <option value="delivery">📦 Доставка</option>
              <option value="exploration">🗺 Исследование</option>
              <option value="combat">⚔ Зачистка</option>
              <option value="escort">🛡 Сопровождение</option>
              <option value="investigation">🔍 Расследование</option>
            </select>
          </label>
          <label>Целевое поселение
            <select name="quest-settlement">
              <option value="">— Любое —</option>
              {{#each settlements}}
              <option value="{{name}}">{{name}}</option>
              {{/each}}
            </select>
          </label>
          <label>Связанный POI
            <select name="quest-poi">
              <option value="">— Без привязки —</option>
              {{#each pois}}
              <option value="{{id}}">{{name}} ({{type}} т{{tier}})</option>
              {{/each}}
            </select>
          </label>
          <label>Сложность (1-10, 0 = авто)
            <select name="quest-difficulty">
              <option value="0">🎲 Авто</option>
              <option value="1">1 — Подручный (медь, травы)</option>
              <option value="2">2 — Новичок</option>
              <option value="3">3 — Опытный (железо, бандиты)</option>
              <option value="4">4 — Умелый (сталь, логова)</option>
              <option value="5">5 — Ветеран</option>
              <option value="6">6 — Профессионал (подземелья)</option>
              <option value="7">7 — Мастер (митрил, боссы)</option>
              <option value="8">8 — Элита</option>
              <option value="9">9 — Герой (легендарные угрозы)</option>
              <option value="10">10 — Легенда</option>
            </select>
          </label>
          <label>Награда (медь, 0 = авто)
            <input type="number" name="quest-reward" value="0">
          </label>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn ih-btn-primary" data-action="generate-quest">📜 Создать квест</a>
          <a class="ih-btn" data-action="generate-quest-pack">📚 Набор квестов (3 шт)</a>
        </div>
      </div>

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">🎭 Сюжетная арка</div>
        <div class="ih-wt-fields">
          <label>Тип арки
            <select name="arc-type">
              <option value="auto">🎲 Авто</option>
              <option value="crisis">🔥 Кризис поселения</option>
              <option value="recovery">🌱 Восстановление</option>
              <option value="war">⚔ Война фракций</option>
              <option value="mystery">🔮 Тайна</option>
            </select>
          </label>
          <label>Регион
            <select name="arc-region">
              {{#each regions}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
          </label>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn" data-action="generate-regional-quests">🗺 Региональные квесты</a>
          <a class="ih-btn" data-action="generate-story-arc">🎭 Сюжетная арка</a>
        </div>
      </div>

    </div>
  </div>

  {{!-- ══════════════════════════════════════════════════════ --}}
  {{!-- ВКЛАДКА: NPC --}}
  {{!-- ══════════════════════════════════════════════════════ --}}
  <div class="ih-wt-panel" data-panel="npc">
    <div class="ih-wt-grid">

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">👤 Генератор NPC</div>
        <p class="muted-text ih-wt-note-block">
          Ступень задаёт навыки, лут трупа и карманничество. Компендиум NPC по умолчанию пуст —
          квестовых персонажей сохраняйте вручную.
        </p>
        <div class="ih-wt-fields">
          <label>Специализация
            <select name="npc-role">
              {{#each npcRoles}}
              <option value="{{id}}">{{text}}</option>
              {{/each}}
            </select>
          </label>
          <label>Тир (1-10)
            <select name="npc-tier">
              <option value="1">1 — Простолюдин (медь)</option>
              <option value="2">2 — Начинающий (бронза)</option>
              <option value="3">3 — Опытный (железо)</option>
              <option value="4">4 — Умелый (сталь)</option>
              <option value="5">5 — Ветеран</option>
              <option value="6">6 — Профессионал</option>
              <option value="7">7 — Мастер (митрил)</option>
              <option value="8">8 — Элита</option>
              <option value="9">9 — Герой</option>
              <option value="10">10 — Легенда (адамантий)</option>
            </select>
          </label>
          <label>Фракция
            <div class="ih-wt-picker-row">
              <input type="text" name="npc-faction" placeholder="Или выбрать →">
              <a class="ih-btn ih-btn-small" data-pick-faction>📋</a>
            </div>
          </label>
          <label>Поселение
            <select name="npc-settlement">
              <option value="">— Без привязки —</option>
              {{#each settlements}}
              <option value="{{name}}">{{name}}</option>
              {{/each}}
            </select>
          </label>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn ih-btn-primary" data-action="generate-npc">👤 Создать NPC</a>
          <a class="ih-btn" data-action="generate-npc-pack">👥 Группа (5 шт)</a>
        </div>
      </div>

    </div>
  </div>

  {{!-- ══════════════════════════════════════════════════════ --}}
  {{!-- ВКЛАДКА: СИМУЛЯЦИЯ --}}
  {{!-- ══════════════════════════════════════════════════════ --}}
  <div class="ih-wt-panel" data-panel="simulation">
    <div class="ih-wt-grid">

      <div class="ih-wt-card ih-wt-card-wide">
        <div class="ih-wt-card-title">🌍 Глобальный тик мира</div>
        <p class="muted-text ih-wt-note-block">
          Обновляет все поселения, кризисы, стабилизацию, POI, торговцев.
          Рекомендуется раз в игровую неделю.
        </p>
        <div class="ih-wt-actions">
          <a class="ih-btn ih-btn-primary" data-action="advance-world">⏩ Глобальный тик</a>
          <a class="ih-btn" data-action="restock-merchants">🔄 Пополнить всех торговцев</a>
        </div>
      </div>

      <div class="ih-wt-card">
        <div class="ih-wt-card-title">📈 Состояние мира</div>
        <div class="ih-wt-actions ih-wt-actions-spaced">
          <a class="ih-btn" data-action="world-status">📊 Показать статус</a>
        </div>
        {{#if worldStatus}}
        <div class="ih-wt-status-list">
          {{#each worldStatus}}
          <div class="ih-wt-status-row">
            <span>{{settlement}}</span>
            <span class="ih-wt-tag">P{{prosperity}}</span>
            <span class="ih-wt-tag {{#if (gt danger 6)}}tag-danger{{/if}}">D{{danger}}</span>
            <span class="ih-wt-tag">{{economy}}</span>
          </div>
          {{/each}}
        </div>
        {{/if}}
      </div>

    </div>
  </div>

  <div class="ih-wt-panel" data-panel="release">
    <div class="ih-wt-grid">

      <div class="ih-wt-card ih-wt-card-wide ih-wt-release-hero">
        <div class="ih-wt-card-title">Release QA</div>
        <div class="ih-wt-release-score">
          <strong>{{releaseQa.scorePct}}%</strong>
          <span>{{releaseQa.stageLabel}}</span>
          <em>{{releaseQa.nextAction}}</em>
        </div>
        <div class="ih-wt-actions">
          <a class="ih-btn ih-btn-primary" data-action="release-content-readiness">Content readiness</a>
          <a class="ih-btn" data-action="release-art-cockpit">Art cockpit</a>
          <a class="ih-btn" data-action="release-session-readiness">Session readiness</a>
          <a class="ih-btn" data-action="release-pack-plan">Pack plan</a>
          <a class="ih-btn" data-action="release-pipeline-dry-run">Pipeline dry-run</a>
          <a class="ih-btn" data-action="release-runtime-smoke">Runtime smoke</a>
          <a class="ih-btn" data-action="release-qa-report">Report to chat</a>
        </div>
        <div class="ih-wt-release-toolbelt">
          <a class="ih-btn" data-action="release-open-tool" data-tool="combat-director">Combat Director</a>
          <a class="ih-btn" data-action="release-open-tool" data-tool="combat-hud">Combat HUD</a>
          <a class="ih-btn" data-action="release-open-tool" data-tool="combat-manager">Combat Manager</a>
          <a class="ih-btn" data-action="release-open-tool" data-tool="inventory">Inventory</a>
          <a class="ih-btn" data-action="release-open-tool" data-tool="map">World Map</a>
          <a class="ih-btn" data-action="release-open-tool" data-tool="map-region">Map: Region</a>
          <a class="ih-btn" data-action="release-open-tool" data-tool="map-local">Map: Local</a>
          <a class="ih-btn" data-action="release-open-tool" data-tool="map-encounter">Map: Encounter</a>
          <a class="ih-btn" data-action="release-open-tool" data-tool="compendium">Compendium</a>
        </div>
      </div>

      <div class="ih-wt-card ih-wt-card-wide ih-wt-situation-cockpit">
        <div class="ih-wt-card-title">GM Situation Cockpit</div>
        <div class="ih-wt-situation-form">
          <label>
            <span>Map level</span>
            <select name="situation-level">
              {{#each situationCockpit.levelOptions}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Terrain</span>
            <select name="situation-terrain">
              {{#each situationCockpit.terrainOptions}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Situation</span>
            <select name="situation-kind">
              {{#each situationCockpit.kindOptions}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Tier</span>
            <select name="situation-tier">
              {{#each situationCockpit.tierOptions}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Reroll mode</span>
            <select name="situation-reroll-mode">
              {{#each situationCockpit.rerollModeOptions}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
          <label>
            <span>Label</span>
            <input type="text" name="situation-label" value="{{situationCockpit.options.label}}" placeholder="Optional focus label">
          </label>
          <label>
            <span>Seed lock</span>
            <input type="text" name="situation-seed" value="{{situationCockpit.options.seedInput}}" placeholder="Blank = fresh roll">
          </label>
        </div>

        <div class="ih-wt-situation-toolbar">
          <div class="ih-wt-situation-pool">
            <strong>{{situationCockpit.pool.total}}</strong>
            <span>maps in pool</span>
            <em>{{situationCockpit.pool.levelCount}} level / {{situationCockpit.pool.terrainCount}} terrain / {{situationCockpit.pool.kindCount}} kind</em>
