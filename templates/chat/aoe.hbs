{{!-- Iron Hills AoE attack/spell summary chat card. --}}

<div class="ih-chat-card ih-aoe-chat-card {{cardClass}}">
  <div class="ih-aoe-chat-head">
    <div class="ih-aoe-chat-title">
      <span class="ih-aoe-chat-icon">{{icon}}</span>
      <span>{{label}}</span>
    </div>
  </div>

  <div class="ih-aoe-stat-row">
    {{#each statPills}}
    <span class="ih-aoe-stat {{className}}">
      <span class="ih-aoe-stat-label">{{label}}</span>
      <b>{{value}}</b>
    </span>
    {{/each}}
  </div>

  <div class="ih-aoe-meta-grid">
    {{#each metaRows}}
    <div class="ih-aoe-meta">
      <span>{{label}}</span>
      <b>{{value}}</b>
    </div>
    {{/each}}
  </div>

  {{#if executionRows.length}}
  <div class="ih-aoe-execution-grid">
    {{#each executionRows}}
    <div class="ih-aoe-execution {{className}}">
      <span>{{label}}</span>
      <b>{{value}}</b>
      {{#if note}}<small>{{note}}</small>{{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{#if noticeRows.length}}
  <div class="ih-aoe-notices">
    {{#each noticeRows}}
    <div class="ih-aoe-notice {{className}}">{{text}}</div>
    {{/each}}
  </div>
  {{/if}}

  {{#if hasResults}}
  <div class="ih-aoe-result-list">
    {{#each results}}
    <div class="ih-aoe-result {{className}}">
      <span class="ih-aoe-result-status">{{statusIcon}}</span>
      <div class="ih-aoe-result-main">
        <div class="ih-aoe-result-name">
          <b>{{name}}</b>
          <span>{{sideLabel}}</span>
        </div>
        {{#if badges.length}}
        <div class="ih-aoe-result-badges">
          {{#each badges}}
          <span class="ih-aoe-result-badge {{className}}">{{text}}</span>
          {{/each}}
        </div>
        {{/if}}
        <div class="ih-aoe-result-outcome">{{outcome}}</div>
        {{#if impactTrack.segments.length}}
        <div class="ih-aoe-result-impact-track {{impactTrack.className}}">
          {{#each impactTrack.segments}}
          <div class="ih-aoe-result-impact-segment {{className}}">
            <span>{{label}}</span>
            <b>{{value}}</b>
            {{#if note}}<small>{{note}}</small>{{/if}}
          </div>
          {{/each}}
        </div>
        {{/if}}
        {{#if detailRows.length}}
        <div class="ih-aoe-result-details">
          {{#each detailRows}}
          <div class="ih-aoe-result-detail {{className}}">
            <span>{{label}}</span>
            <b>{{value}}</b>
          </div>
          {{/each}}
        </div>
        {{else}}
        {{#if metaText}}
        <div class="ih-aoe-result-meta">{{metaText}}</div>
        {{/if}}
        {{/if}}
      </div>
    </div>
    {{/each}}
  </div>
  {{/if}}
</div>
