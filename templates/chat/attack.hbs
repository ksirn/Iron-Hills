{{!-- Iron Hills single-target attack summary chat card. --}}

<div class="ih-chat-card ih-attack-chat-card {{attack.cardClass}}">
  <div class="ih-attack-chat-head">
    <div class="ih-attack-chat-title">
      <span class="ih-attack-chat-icon">{{attack.icon}}</span>
      <span>{{attack.title}}</span>
    </div>
    <span class="ih-attack-status {{attack.statusClass}}">{{attack.statusLabel}}</span>
  </div>

  <div class="ih-attack-stat-row">
    {{#each attack.statPills}}
    <span class="ih-attack-stat {{className}}">
      <span class="ih-attack-stat-label">{{label}}</span>
      <b>{{value}}</b>
    </span>
    {{/each}}
  </div>

  <div class="ih-attack-meta-grid">
    {{#each attack.metaRows}}
    <div class="ih-attack-meta">
      <span>{{label}}</span>
      <b>{{value}}</b>
    </div>
    {{/each}}
  </div>

  {{#if attack.impactTrack.segments.length}}
  <div class="ih-attack-impact-track {{attack.impactTrack.className}}">
    {{#each attack.impactTrack.segments}}
    <div class="ih-attack-impact-segment {{className}}">
      <span>{{label}}</span>
      <b>{{value}}</b>
      {{#if note}}<small>{{note}}</small>{{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}

  {{#if attack.rollRows.length}}
  <div class="ih-attack-section">
    <div class="ih-attack-section-title">Бросок</div>
    <div class="ih-attack-detail-grid">
      {{#each attack.rollRows}}
      <div class="ih-attack-detail {{className}}">
        <span>{{label}}</span>
        <b>{{value}}</b>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if attack.damageRows.length}}
  <div class="ih-attack-section">
    <div class="ih-attack-section-title">Урон</div>
    <div class="ih-attack-detail-grid">
      {{#each attack.damageRows}}
      <div class="ih-attack-detail {{className}}">
        <span>{{label}}</span>
        <b>{{value}}</b>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if attack.noticeRows.length}}
  <div class="ih-attack-notices">
    {{#each attack.noticeRows}}
    <div class="ih-attack-notice {{className}}">
      <span>{{label}}</span>
      <b>{{value}}</b>
    </div>
    {{/each}}
  </div>
  {{/if}}
</div>
