{{!-- Iron Hills — Item Sheet v2 --}}
<form class="ih-is-app" autocomplete="off">

  {{!-- Шапка --}}
  <div class="ih-is-header" data-ih-style-quality-color="{{qualityCfg.color}}">
    <div class="ih-is-portrait-wrap">
      <img class="ih-is-portrait" src="{{item.img}}" alt="{{item.name}}">
      <div class="ih-is-type-badge">
        {{#if isWeapon}}⚔{{else if isArmor}}🛡{{else if isPotion}}⚗{{else if isFood}}🍖{{else if isMaterial}}⛏{{else if isTool}}🔨{{else if isSpell}}✦{{else}}📦{{/if}}
      </div>
    </div>
    <div class="ih-is-identity">
      <input class="ih-is-name" type="text" name="name" value="{{item.name}}" placeholder="Название">
      <div class="ih-is-meta">
        {{!-- Тир --}}
        <div class="ih-is-field narrow">
          <label>Ступень</label>
          <input type="number" name="system.tier" value="{{system.tier}}" min="1" max="10">
        </div>
        {{!-- Качество --}}
        <div class="ih-is-field">
          <label>Качество</label>
          <select name="system.quality">
            {{#each qualityOpts}}
            <option value="{{key}}" {{#if (eq key ../system.quality)}}selected{{/if}}
                    data-ih-style-color="{{color}}">{{label}}</option>
            {{/each}}
          </select>
        </div>
        {{!-- Вес --}}
        <div class="ih-is-field narrow">
          <label>Вес</label>
          <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1">
        </div>
        {{!-- Количество --}}
        <div class="ih-is-field narrow">
          <label>Кол-во</label>
          <input type="number" name="system.quantity" value="{{system.quantity}}" min="0">
        </div>
        {{!-- Цена --}}
        <div class="ih-is-field narrow">
          <label>Цена (мед.)</label>
          <input type="number" name="system.value" value="{{system.value}}" min="0">
        </div>
      </div>
      {{!-- Цена с качеством --}}
      {{#if effectiveValue}}
      <div class="ih-is-effective-value" data-ih-style-color="{{qualityCfg.color}}">
        💰 {{effectiveValue}} мед. с учётом качества (×{{qualityCfg.mult}})
      </div>
      {{/if}}
    </div>
  </div>

  {{!-- Тело --}}
  <div class="ih-is-body">

    {{!-- ── ОРУЖИЕ ── --}}
    {{#if isWeapon}}
    <div class="ih-is-section">
      <div class="ih-is-section-title">⚔ Боевые параметры</div>
      <div class="ih-is-grid">
        <div class="ih-is-field">
          <label>Навык</label>
          <select name="system.skill">
            {{#each skillOptions}}
            <option value="{{key}}" {{#if (eq key ../system.skill)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Тип урона</label>
          <select name="system.damageType">
            {{#each damageTypeOptions}}
            <option value="{{key}}" {{#if (eq key ../system.damageType)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Базовый урон</label>
          <input type="number" name="system.damage" value="{{system.damage}}" min="0">
          {{#if qualityDamageBonus}}
          <span class="ih-is-bonus" data-ih-style-color="{{qualityCfg.color}}">{{qualityDamageBonus}}</span>
          {{/if}}
        </div>
        <div class="ih-is-field narrow">
          <label>Затрата энергии</label>
          <input type="number" name="system.energyCost" value="{{system.energyCost}}" min="0">
        </div>
        <div class="ih-is-field narrow">
          <label>Прочность</label>
          <input type="number" name="system.durability.max" value="{{system.durability.max}}" min="0">
        </div>
        <div class="ih-is-field narrow">
          <label>Двуручное</label>
          <input type="checkbox" name="system.twoHanded" {{checked system.twoHanded}}>
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- ── БРОНЯ ── --}}
    {{#if isArmor}}
    <div class="ih-is-section">
      <div class="ih-is-section-title">🛡 Защита</div>
      <div class="ih-is-grid">
        <div class="ih-is-field">
          <label>Слот</label>
          <select name="system.slot">
            {{#each armorSlots}}
            <option value="{{key}}" {{#if (eq key ../system.slot)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Класс</label>
          <select name="system.armorClass">
            {{#each armorClassOptions}}
            <option value="{{key}}" {{#if (eq key ../system.armorClass)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Выносл.</label>
          <input type="number" name="system.requirements.endurance" value="{{system.requirements.endurance}}" min="0">
        </div>
        <div class="ih-is-field narrow">
          <label>Атлетика</label>
          <input type="number" name="system.requirements.athletics" value="{{system.requirements.athletics}}" min="0">
        </div>
        {{#each armorResistanceOptions}}
        <div class="ih-is-field resist">
          <label>{{label}}</label>
          <input type="number" name="system.protection.{{key}}" value="{{value}}" min="0">
        </div>
        {{/each}}
        <div class="ih-is-field narrow">
          <label>Прочность</label>
          <input type="number" name="system.durability.max" value="{{system.durability.max}}" min="0">
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- ── МЕТАТЕЛЬНОЕ ── --}}
    {{#if isThrowable}}
    <div class="ih-is-section">
      <div class="ih-is-section-title">🎯 Метание</div>
      <div class="ih-is-grid">
        <div class="ih-is-field">
          <label>Тип урона</label>
          <select name="system.damageType">
            {{#each damageTypeOptions}}
            <option value="{{key}}" {{#if (eq key ../system.damageType)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Урон</label>
          <input type="number" name="system.power" value="{{system.power}}" min="0">
        </div>
        <div class="ih-is-field narrow">
          <label>Энергия</label>
          <input type="number" name="system.energyCost" value="{{system.energyCost}}" min="0">
        </div>
        <div class="ih-is-field">
          <label>Зона по умолчанию</label>
          <select name="system.targetPart">
            <option value="">— случайная —</option>
            {{#each zoneLabels}}
            <option value="{{@key}}" {{#if (eq @key ../system.targetPart)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Яд</label>
          <input type="number" name="system.appliesPoison" value="{{system.appliesPoison}}" min="0">
        </div>
        <div class="ih-is-field narrow">
          <label>Горение</label>
          <input type="number" name="system.appliesBurning" value="{{system.appliesBurning}}" min="0">
        </div>
      </div>
    </div>

    <div class="ih-is-section">
      <div class="ih-is-section-title">💥 Область броска</div>
      <div class="ih-is-grid">
        <div class="ih-is-field">
          <label>Форма</label>
          <select name="system.aoe.shape">
            {{#each aoeShapeOptions}}
            <option value="{{key}}" {{#if (eq key ../system.aoe.shape)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Логика целей</label>
          <select name="system.aoe.type">
            {{#each aoeTypeOptions}}
            <option value="{{key}}" {{#if (eq key ../system.aoe.type)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Дистанция</label>
          <input type="number" name="system.aoe.distance" value="{{system.aoe.distance}}" min="0" step="1">
        </div>
        <div class="ih-is-field narrow">
          <label>Макс. целей</label>
          <input type="number" name="system.aoe.maxTargets" value="{{system.aoe.maxTargets}}" min="0" step="1">
        </div>
        <div class="ih-is-field narrow">
          <label>Затухание</label>
          <input type="number" name="system.aoe.chainDecay" value="{{system.aoe.chainDecay}}" min="0" max="1" step="0.05">
        </div>
        <div class="ih-is-field">
          <label>Логика зон</label>
          <select name="system.aoe.targetZoneMode">
            {{#each aoeZoneModeOptions}}
            <option value="{{key}}" {{#if (eq key ../system.aoe.targetZoneMode)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Зона AoE</label>
          <select name="system.aoe.targetZone">
            <option value="">— авто —</option>
            {{#each zoneLabels}}
            <option value="{{@key}}" {{#if (eq @key ../system.aoe.targetZone)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Friendly fire</label>
          <select name="system.aoe.friendlyFireMode">
            {{#each aoeFriendlyFireOptions}}
            <option value="{{key}}" {{#if (eq key ../system.aoe.friendlyFireMode)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Legacy FF</label>
          <input type="checkbox" name="system.friendlyFire" {{checked system.friendlyFire}}>
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- ── ЗАКЛИНАНИЕ / СВИТОК ── --}}
    {{#if isSpell}}
    <div class="ih-is-section">
      <div class="ih-is-section-title">✦ Заклинание</div>
      <div class="ih-is-grid">
        <div class="ih-is-field">
          <label>ID</label>
          <input type="text" name="system.spellId" value="{{system.spellId}}">
        </div>
        <div class="ih-is-field">
          <label>Школа</label>
          <select name="system.school">
            <option value="">— школа —</option>
            {{#each spellSchoolOptions}}
            <option value="{{key}}" {{#if (eq key ../system.school)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Ранг</label>
          <input type="number" name="system.rank" value="{{system.rank}}" min="1" step="1">
        </div>
        <div class="ih-is-field narrow">
          <label>Мана</label>
          <input type="number" name="system.manaCost" value="{{system.manaCost}}" min="0" step="1">
        </div>
        <div class="ih-is-field narrow">
          <label>Энергия</label>
          <input type="number" name="system.energyCost" value="{{system.energyCost}}" min="0" step="1">
        </div>
        <div class="ih-is-field narrow">
          <label>Каст, сек</label>
          <input type="number" name="system.castTime" value="{{system.castTime}}" min="0" step="1">
        </div>
      </div>
    </div>

    <div class="ih-is-section">
      <div class="ih-is-section-title">⚔ Урон и эффект</div>
      <div class="ih-is-grid">
        <div class="ih-is-field">
          <label>Тип урона</label>
          <select name="system.damageType">
            {{#each spellDamageTypeOptions}}
            <option value="{{key}}" {{#if (eq key ../system.damageType)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Тип эффекта</label>
          <select name="system.effectType">
            {{#each spellEffectTypeOptions}}
            <option value="{{key}}" {{#if (eq key ../system.effectType)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Урон</label>
          <input type="number" name="system.damage" value="{{system.damage}}" min="0" step="1">
        </div>
        <div class="ih-is-field narrow">
          <label>Сила</label>
          <input type="number" name="system.power" value="{{system.power}}" min="0" step="1">
        </div>
        <div class="ih-is-field">
          <label>Special</label>
          <select name="system.effect.special">
            {{#each spellSpecialOptions}}
            <option value="{{key}}" {{#if (eq key ../system.effect.special)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Condition</label>
          <select name="system.effect.applyCondition">
            {{#each spellConditionOptions}}
            <option value="{{key}}" {{#if (eq key ../system.effect.applyCondition)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Длит., сек</label>
          <input type="number" name="system.effect.conditionDuration" value="{{system.effect.conditionDuration}}" min="0" step="1">
        </div>
        <div class="ih-is-field narrow">
          <label>Шанс</label>
          <input type="number" name="system.effect.conditionChance" value="{{system.effect.conditionChance}}" min="0" max="1" step="0.05">
        </div>
        <div class="ih-is-field narrow">
          <label>Лечение</label>
          <input type="number" name="system.effect.healAmount" value="{{system.effect.healAmount}}" min="0" step="1">
        </div>
        <div class="ih-is-field">
          <label>Summon</label>
          <select name="system.effect.summonId">
            {{#each spellSummonOptions}}
            <option value="{{key}}" {{#if (eq key ../system.effect.summonId)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Summon, сек</label>
          <input type="number" name="system.effect.duration" value="{{system.effect.duration}}" min="0" step="1">
        </div>
      </div>
    </div>

    <div class="ih-is-section">
      <div class="ih-is-section-title">🎯 Цели</div>
      <div class="ih-is-grid">
        <div class="ih-is-field">
          <label>Scope</label>
          <select name="system.applicationScope">
            {{#each applicationScopeLabels}}
            <option value="{{@key}}" {{#if (eq @key ../system.applicationScope)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Actor mode</label>
          <select name="system.targetActorMode">
            {{#each targetActorModeLabels}}
            <option value="{{@key}}" {{#if (eq @key ../system.targetActorMode)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Зона цели</label>
          <select name="system.targetPart">
            <option value="">— авто —</option>
            {{#each zoneLabels}}
            <option value="{{@key}}" {{#if (eq @key ../system.targetPart)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Target zone</label>
          <select name="system.targetZone">
            <option value="">— авто —</option>
            {{#each zoneLabels}}
            <option value="{{@key}}" {{#if (eq @key ../system.targetZone)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Логика зон</label>
          <select name="system.targetZoneMode">
            {{#each aoeZoneModeOptions}}
            <option value="{{key}}" {{#if (eq key ../system.targetZoneMode)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Friendly fire</label>
          <select name="system.friendlyFireMode">
            {{#each aoeFriendlyFireOptions}}
            <option value="{{key}}" {{#if (eq key ../system.friendlyFireMode)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>

    <div class="ih-is-section">
      <div class="ih-is-section-title">💥 Область</div>
      <div class="ih-is-grid">
        <div class="ih-is-field">
          <label>Форма</label>
          <select name="system.aoe.shape">
            {{#each aoeShapeOptions}}
            <option value="{{key}}" {{#if (eq key ../system.aoe.shape)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Логика целей</label>
          <select name="system.aoe.type">
            {{#each aoeTypeOptions}}
            <option value="{{key}}" {{#if (eq key ../system.aoe.type)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Дистанция</label>
          <input type="number" name="system.aoe.distance" value="{{system.aoe.distance}}" min="0" step="1">
        </div>
        <div class="ih-is-field narrow">
          <label>Макс. целей</label>
          <input type="number" name="system.aoe.maxTargets" value="{{system.aoe.maxTargets}}" min="0" step="1">
        </div>
        <div class="ih-is-field narrow">
          <label>Затухание</label>
          <input type="number" name="system.aoe.chainDecay" value="{{system.aoe.chainDecay}}" min="0" max="1" step="0.05">
        </div>
        <div class="ih-is-field">
          <label>Логика зон</label>
          <select name="system.aoe.targetZoneMode">
            {{#each aoeZoneModeOptions}}
            <option value="{{key}}" {{#if (eq key ../system.aoe.targetZoneMode)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Зона AoE</label>
          <select name="system.aoe.targetZone">
            <option value="">— авто —</option>
            {{#each zoneLabels}}
            <option value="{{@key}}" {{#if (eq @key ../system.aoe.targetZone)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Friendly fire</label>
          <select name="system.aoe.friendlyFireMode">
            {{#each aoeFriendlyFireOptions}}
            <option value="{{key}}" {{#if (eq key ../system.aoe.friendlyFireMode)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- ── ЗЕЛЬЕ / РАСХОДНИК ── --}}
    {{#if isPotion}}
    <div class="ih-is-section">
      <div class="ih-is-section-title">⚗ Эффект</div>
      <div class="ih-is-grid">
        <div class="ih-is-field wide">
          <label>Тип эффекта</label>
          <select name="system.actionType">
            <option value="">— не настроено —</option>
            {{#each actionTypeLabels}}
            <option value="{{@key}}" {{#if (eq @key ../system.actionType)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Сила эффекта</label>
          <input type="number" name="system.power" value="{{system.power}}" min="0">
        </div>
        <div class="ih-is-field">
          <label>Область применения</label>
          <select name="system.applicationScope">
            {{#each applicationScopeLabels}}
            <option value="{{@key}}" {{#if (eq @key ../system.applicationScope)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field">
          <label>Цель</label>
          <select name="system.targetActorMode">
            {{#each targetActorModeLabels}}
            <option value="{{@key}}" {{#if (eq @key ../system.targetActorMode)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        {{#if (eq system.applicationScope 'targeted')}}
        <div class="ih-is-field">
          <label>Часть тела (по умолчанию)</label>
          <select name="system.targetPart">
            <option value="">— на выбор —</option>
            {{#each zoneLabels}}
            <option value="{{@key}}" {{#if (eq @key ../system.targetPart)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        {{/if}}
        <div class="ih-is-field narrow">
          <label>Длительность (сек)</label>
          <input type="number" name="system.duration" value="{{system.duration}}" min="0"
                 placeholder="0 = мгновенно">
        </div>
      </div>
      {{!-- Описание эффекта --}}
      {{#if effectLabel}}
      <div class="ih-is-effect-hint">
        ℹ {{effectLabel}} — сила {{system.power}}
        {{#if system.duration}}в течение {{system.duration}}с{{/if}}
      </div>
      {{/if}}
    </div>
    {{/if}}

    {{!-- ── ЕДА ── --}}
    {{#if isFood}}
    <div class="ih-is-section">
      <div class="ih-is-section-title">🍖 Питательность</div>
      <div class="ih-is-grid">
        <div class="ih-is-field narrow">
          <label>🍖 Сытость</label>
          <input type="number" name="system.satiety" value="{{system.satiety}}" min="0">
        </div>
        <div class="ih-is-field narrow">
          <label>💧 Жажда</label>
          <input type="number" name="system.hydration" value="{{system.hydration}}" min="0">
        </div>
        <div class="ih-is-field narrow">
          <label>⚡ Бонус энергии</label>
          <input type="number" name="system.energyBonus" value="{{system.energyBonus}}" min="0">
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- ── МАТЕРИАЛ ── --}}
    {{#if isMaterial}}
    <div class="ih-is-section">
      <div class="ih-is-section-title">⛏ Свойства</div>
      <div class="ih-is-grid">
        <div class="ih-is-field">
          <label>Категория</label>
          <select name="system.category">
            {{#each matCategories}}
            <option value="{{key}}" {{#if (eq key ../system.category)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- ── ИНСТРУМЕНТ ── --}}
    {{#if isTool}}
    <div class="ih-is-section">
      <div class="ih-is-section-title">🔨 Параметры</div>
      <div class="ih-is-grid">
        <div class="ih-is-field">
          <label>Тип крафта</label>
          <select name="system.craftType">
            {{#each craftTypes}}
            <option value="{{key}}" {{#if (eq key ../system.craftType)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
        <div class="ih-is-field narrow">
          <label>Прочность</label>
          <input type="number" name="system.durability.max" value="{{system.durability.max}}" min="0">
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- Описание (для всех) --}}
    <div class="ih-is-section">
      <div class="ih-is-section-title">📝 Описание</div>
      <textarea class="ih-is-desc" name="system.description"
                placeholder="Описание предмета...">{{system.description}}</textarea>
    </div>

  </div>

  <div class="ih-is-save-bar">
    <a class="ih-btn ih-btn-primary" data-save-item>💾 Сохранить</a>
  </div>
</form>
